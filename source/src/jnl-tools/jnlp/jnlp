class JnlTrack:
    """单个 .jnl 曲目的封装：读取元数据、按需解压、解析歌词。"""

    def __init__(self, jnl_path):
        self.path = Path(jnl_path)
        self.meta = {}
        self.audio_path = None      # 解压后的临时音频路径
        self.cover_path = None      # 解压后的封面路径
        self.lyrics = []            # [(time_ms, text), ...]
        self._tmpdir = None
        self._load()

    def _load(self):
        """从 .jnl 中读取 meta.json（不解压整个包，仅读取该条目）。"""
        try:
            with zipfile.ZipFile(self.path, 'r') as zf:
                try:
                    with zf.open('meta.json') as f:
                        self.meta = json.load(f)
                except KeyError:
                    # meta.json 不在根目录，尝试查找任意 meta.json
                    names = [n for n in zf.namelist()
                             if n.endswith('meta.json') and not n.startswith('__')]
                    if names:
                        with zf.open(names[0]) as f:
                            self.meta = json.load(f)
                    else:
                        self.meta = {'title': self.path.stem, 'artist': 'Unknown'}
        except Exception as e:
            print(f"警告：无法读取 {self.path} 的 meta.json: {e}")
            self.meta = {'title': self.path.stem, 'artist': 'Unknown'}

    def extract(self):
        """解压 .jnl 到临时目录，并定位音频/封面/歌词。"""
        if self._tmpdir:
            return  # 已解压
        self._tmpdir = Path(tempfile.mkdtemp(prefix='jnlp-'))
        try:
            with zipfile.ZipFile(self.path, 'r') as zf:
                # 安全解压：禁止路径穿越
                for member in zf.namelist():
                    # 规范约束：条目位于根目录，无 .. 段、无绝对路径
                    if member.startswith(('/', '\\')) or '..' in member.split('/'):
                        print(f"警告：跳过不安全条目 {member}")
                        continue
                    zf.extract(member, self._tmpdir)
        except Exception as e:
            print(f"错误：解压 {self.path} 失败: {e}")
            return

        # 定位音频：优先 audio.<ext>
        for ext in SUPPORTED_AUDIO:
            p = self._tmpdir / ('audio' + ext)
            if p.exists():
                self.audio_path = p
                break
        # 兜底：扫描目录中任意受支持的音频
        if not self.audio_path:
            for p in self._tmpdir.iterdir():
                if p.is_file() and p.suffix.lower() in SUPPORTED_AUDIO:
                    self.audio_path = p
                    break

        # 定位封面
        for name in ('cover.jpg', 'cover.jpeg', 'cover.png'):
            p = self._tmpdir / name
            if p.exists():
                self.cover_path = p
                break

        # 解析歌词
        lrc = self._tmpdir / 'lyrics.lrc'
        if lrc.exists():
            try:
                self.lyrics = self._parse_lrc(lrc.read_text(encoding='utf-8'))
            except Exception as e:
                print(f"警告：解析歌词失败: {e}")
                self.lyrics = []

    def cleanup(self):
        """清理临时目录。"""
        if self._tmpdir and self._tmpdir.exists():
            shutil.rmtree(self._tmpdir, ignore_errors=True)
            self._tmpdir = None
            self.audio_path = None
            self.cover_path = None

    @staticmethod
    def _parse_lrc(text):
        """解析 LRC 格式歌词，返回 [(time_ms, text), ...]。
        支持 [mm:ss.xx] 与 [mm:ss]，支持一行多时间标签。
        """
        result = []
        time_re = re.compile(r'\[(\d+):(\d+)(?:[.:](\d+))?\]')
        for line in text.splitlines():
            line = line.rstrip('\r')
            if not line.strip():
                continue
            # 提取行内所有时间标签，剩余部分为歌词文本
            matches = list(time_re.finditer(line))
            if not matches:
                continue
            text_part = line[matches[-1].end():].strip()
            for m in matches:
                mm = int(m.group(1))
                ss = int(m.group(2))
                frac = m.group(3)
                ms = int(frac.ljust(3, '0')[:3]) if frac else 0
                t = mm * 60000 + ss * 1000 + ms
                result.append((t, text_part))
        return sorted(result, key=lambda x: x[0])

    @property
    def title(self):
        return self.meta.get('title', self.path.stem)

    @property
    def artist(self):
        return self.meta.get('artist', 'Unknown')

    @property
    def album(self):
        return self.meta.get('album', '')

    @property
    def duration_sec(self):
        try:
            return int(self.meta.get('duration', 0))
        except (TypeError, ValueError):
            return 0


class JnlpApplication(Gtk.Application):
    """JNL Player 主应用（GTK4 Application，单实例）。"""

    def __init__(self):
        super().__init__(application_id='org.jnl_os.Player',
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.tracks = []
        self.current_index = -1
        self.current_track = None
        self.player = None
        self.is_playing = False
        self._lyrics_update_id = None
        self._seek_dragging = False        # 进度条是否正被用户拖动
        self._suppress_select = False     # 程序设置选中时屏蔽回调
        self._dbus_connection = None
        self._dbus_reg_id = None
        self._seek_handler_id = 0
        self._volume_handler_id = 0
        self._initialized = False

    # ------------------------------------------------------------------ #
    # 命令行处理
    # ------------------------------------------------------------------ #
    def do_local_command_line(self, args):
        """在发起进程本地处理命令行。
        --help 在本地直接输出并退出（不转发到主实例）。
        """
        argv = list(args)
        if '--help' in argv or '-h' in argv:
            self._print_help()
            return (0, [])
        # 其余交给默认处理（转发到已运行实例或本地启动）
        return Gtk.Application.do_local_command_line(self, args)

    def do_command_line(self, cmdline):
        """主实例处理命令行（含单实例转发场景）。"""
        args = cmdline.get_arguments()
        file_arg = None
        for a in args[1:]:
            if a.startswith('-'):
                continue
            p = Path(a)
            if p.is_file() and p.suffix.lower() == '.jnl':
                file_arg = str(p.resolve())
                break
        # 确保窗口存在并前置
        self.activate()
        if file_arg:
            # 等待 UI 就绪后播放
            GLib.idle_add(self._play_external_file, file_arg)
        return 0

    @staticmethod
    def _print_help():
        print("""jnlp - JNL Player (Java Net Lava Player)
.jnl 音乐包格式桌面播放器

用法:
  jnlp                  打开图形界面并扫描音乐库
  jnlp <file.jnl>       直接播放指定的 .jnl 文件
  jnlp --help           显示本帮助信息

音乐库目录: ~/.local/share/jnl-os/music/

DBus 接口: org.jnl_os.Player  (对象路径 /org/jnl_os/Player)
  方法: Play / Pause / Next / Previous / Stop / PlayTrack
        GetStatus / GetSongInfo / SetVolume / GetVolume
  信号: SongChanged / StatusChanged

依赖: python-gobject, gtk4, gstreamer, gst-plugins-good""")

    # ------------------------------------------------------------------ #
    # 应用激活
    # ------------------------------------------------------------------ #
    def do_activate(self):
        """激活应用：创建/前置主窗口。"""
        self._ensure_window()

    def _ensure_window(self):
        """确保主窗口已构建（仅构建一次），并前置显示。"""
        win = self.get_active_window()
        if win is None:
            win = Gtk.ApplicationWindow(application=self)
            win.set_title('JNL Player')
            win.set_default_size(900, 640)
            self._build_ui(win)
            self._init_player()
            self._scan_library()
            self._start_dbus()
            self._initialized = True
        win.present()

    # ------------------------------------------------------------------ #
    # UI 构建
    # ------------------------------------------------------------------ #
    def _build_ui(self, win):
        """构建主界面。"""
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        main_box.set_margin_start(12)
        main_box.set_margin_end(12)
        main_box.set_margin_top(12)
        main_box.set_margin_bottom(12)

        # === 顶部：封面 + 元数据 ===

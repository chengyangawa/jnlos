            Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.volume_btn.set_value(80)
        self.volume_btn.set_draw_value(False)
        self.volume_btn.set_size_request(160, -1)
        self._volume_handler_id = self.volume_btn.connect(

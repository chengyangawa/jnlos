#!/usr/bin/env python3
"""
jnlp - Java Net Lava Player
.jnl 音乐包格式桌面播放器

依赖：
  - python-gobject (PyGObject)
  - gtk4
  - gstreamer + gst-plugins-good (+ gst-plugins-base)

.jnl 是 Java Net Lava OS 自定义的音乐打包格式（本质为 ZIP），
内部包含 audio.<ext>、meta.json、cover.jpg(可选)、lyrics.lrc(可选)。
格式规范详见 src/jnl-tools/spec/FORMAT.md。

功能：
  - 扫描 ~/.local/share/jnl-os/music/*.jnl 音乐库
  - GStreamer 播放/暂停/停止/上一首/下一首/拖动跳转/音量调节
  - 元数据、封面、时间同步歌词显示
  - DBus 服务 org.jnl_os.Player 供 GNOME Shell 扩展控制

用法：
  jnlp                  打开图形界面并扫描音乐库
  jnlp <file.jnl>       直接播放指定 .jnl 文件
  jnlp --help           显示帮助
"""
import os
import re
import sys
import json
import shutil
import zipfile
import tempfile
from pathlib import Path

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Gst', '1.0')
gi.require_version('GdkPixbuf', '2.0')
gi.require_version('GLib', '2.0')

from gi.repository import Gtk, Gst, GLib, GdkPixbuf, Gio

# 初始化 GStreamer
Gst.init(None)

# 音乐库目录：以规范约定的 ~/.local/share/jnl-os/music 为主
MUSIC_DIR = Path.home() / '.local' / 'share' / 'jnl-os' / 'music'

# 支持的音频扩展名（前四项符合 FORMAT.md 规范，.wav/.opus 作为兜底）
SUPPORTED_AUDIO = ('.mp3', '.flac', '.ogg', '.m4a', '.wav', '.opus')

# DBus 自省 XML：定义 org.jnl_os.Player 接口
DBUS_INTROSPECTION_XML = """

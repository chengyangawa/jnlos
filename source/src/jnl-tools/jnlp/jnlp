        self.track_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.track_list.connect('row-selected', self._on_track_selected)
        scroll.set_child(self.track_list)
        playlist_frame.set_child(scroll)
        content_box.append(playlist_frame)
        main_box.append(content_box)

        # === 控制区 ===
        ctrl_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        # 按钮行
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                          spacing=5, homogeneous=True)
        self.prev_btn = Gtk.Button(label='上一首')
        self.prev_btn.connect('clicked', self._on_prev)
        self.play_btn = Gtk.Button(label='播放')
        self.play_btn.connect('clicked', self._on_play_pause)

    # ------------------------------------------------------------------ #
    # 音乐库扫描
    # ------------------------------------------------------------------ #
    def _scan_library(self):
        """扫描 MUSIC_DIR 下的 .jnl 文件并填充歌单。"""
        try:
            MUSIC_DIR.mkdir(parents=True, exist_ok=True)
        except Exception as e:
            print(f"警告：无法创建音乐库目录 {MUSIC_DIR}: {e}")

        self.tracks = []
        # 清空列表
        while True:
            row = self.track_list.get_first_child()
            if row is None:
                break
            self.track_list.remove(row)

        for jnl_path in sorted(MUSIC_DIR.glob('*.jnl')):
            try:
                track = JnlTrack(jnl_path)
                self.tracks.append(track)
            except Exception as e:
                print(f"警告：跳过 {jnl_path}: {e}")
                continue
            label_text = f"{len(self.tracks)}. {track.title} - {track.artist}"
            row = Gtk.ListBoxRow()
            row.set_child(Gtk.Label(label=label_text, halign=Gtk.Align.START,
                                    margin_start=6, margin_end=6,
                                    margin_top=3, margin_bottom=3))
            self.track_list.append(row)

    # ------------------------------------------------------------------ #
    # GStreamer 播放器
    # ------------------------------------------------------------------ #
    def _init_player(self):
        """初始化 GStreamer playbin。"""
        self.player = Gst.ElementFactory.make('playbin', 'player')
        if self.player is None:
            print("错误：无法创建 GStreamer playbin，请确认已安装 gst-plugins-base。")
            return
        self.player.set_property('volume', 0.8)
        bus = self.player.get_bus()
        bus.add_signal_watch()
        bus.connect('message::eos', self._on_eos)
        bus.connect('message::error', self._on_error)
        bus.connect('message::state-changed', self._on_state_changed)

    def _play_track(self, index):
        """播放指定索引的歌曲。"""
        if not self.tracks or index < 0 or index >= len(self.tracks):
            return
        if self.player is None:
            print("错误：播放器未初始化")
            return

        # 清理前一首的临时目录
        if self.current_track and self.current_track is not self.tracks[index]:
            self.current_track.cleanup()

        self.current_index = index
        self.current_track = self.tracks[index]
        try:
            self.current_track.extract()
        except Exception as e:
            print(f"错误：解压 {self.current_track.path} 失败: {e}")
            return

        # 更新元数据 UI
        self.title_label.set_label(self.current_track.title)
        self.artist_label.set_label(f'艺术家: {self.current_track.artist}')
        self.album_label.set_label(f'专辑: {self.current_track.album or "—"}')
        dur = self.current_track.duration_sec
        self.duration_info_label.set_label(
            f'时长: {self._fmt_time(dur)}'
            + (f'  ·  {self.current_track.meta.get("audio_bitrate")}kbps'
               if self.current_track.meta.get('audio_bitrate') else ''))

        # 加载封面
        self._load_cover(self.current_track.cover_path)

        # 在歌单中选中（屏蔽回调避免重复触发）
        row = self.track_list.get_row_at_index(index)
        if row is not None:
            self._suppress_select = True
            self.track_list.select_row(row)
            self._suppress_select = False

        # 加载音频并播放
        if self.current_track.audio_path:
            try:
                uri = Gst.filename_to_uri(str(self.current_track.audio_path))
            except Exception:
                uri = 'file://' + str(self.current_track.audio_path)
            self.player.set_property('uri', uri)
            self.player.set_state(Gst.State.PLAYING)
            self.is_playing = True
            self.play_btn.set_label('暂停')
            self._emit_song_changed()
            self._emit_status_changed()
        else:
            print(f"警告：{self.current_track.path} 中未找到音频文件")

        # 启动歌词更新定时器
        self._start_lyrics_timer()

    def _load_cover(self, cover_path):
        """加载封面图片到封面控件。"""
        if not cover_path or not Path(cover_path).exists():
            self.cover_image.set_from_icon_name('audio-x-generic')
            return
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                str(cover_path), 150, 150, True)
            if pixbuf is not None:
                self.cover_image.set_from_pixbuf(pixbuf)
            else:
                self.cover_image.set_from_icon_name('audio-x-generic')
        except Exception as e:
            print(f"警告：加载封面失败: {e}")
            self.cover_image.set_from_icon_name('audio-x-generic')

    def _start_lyrics_timer(self):
        """启动（或重启）歌词/进度更新定时器。"""
        if self._lyrics_update_id:
            GLib.source_remove(self._lyrics_update_id)
        self._lyrics_update_id = GLib.timeout_add(200, self._update_lyrics)

    def _update_lyrics(self):
        """定时（200ms）更新歌词高亮与进度条。"""
        if not self.current_track or self.player is None:
            return True

        # 当前播放位置（毫秒）
        ok, pos = self.player.query_position(Gst.Format.TIME)
        pos_ms = (pos // 1_000_000) if ok else 0

        # 渲染歌词
        self._render_lyrics(pos_ms)

        # 更新进度条（用户拖动期间不回写）
        ok_d, dur = self.player.query_duration(Gst.Format.TIME)
        if ok_d and dur > 0:
            dur_ms = dur // 1_000_000
            self.progress_bar.set_range(0, dur_ms)
            if not self._seek_dragging:
                self.progress_bar.handler_block(self._seek_handler_id)
                self.progress_bar.set_value(pos_ms)
                self.progress_bar.handler_unblock(self._seek_handler_id)
            self.time_label.set_label(self._fmt_time(pos_ms // 1000))
            self.duration_label.set_label(self._fmt_time(dur_ms // 1000))
        return True

    def _render_lyrics(self, current_ms):
        """渲染歌词：以当前行为中心，前后若干行，当前行高亮。"""
        lyrics = self.current_track.lyrics if self.current_track else []
        if not lyrics:
            self.lyrics_label.set_label('（无歌词）')
            return
        # 找当前行
        idx = 0
        for i, (t, _txt) in enumerate(lyrics):
            if current_ms >= t:
                idx = i
            else:
                break
        start = max(0, idx - 4)
        end = min(len(lyrics), idx + 6)
        lines = []
        for j in range(start, end):
            _t, txt = lyrics[j]
            esc = GLib.markup_escape_text(txt, -1)
            if j == idx:
                lines.append(
                    f'<span foreground="#FFD700" size="x-large" '
                    f'weight="bold">{esc}</span>')
            else:
                lines.append(
                    f'<span foreground="#aaaaaa" size="medium">{esc}</span>')
        self.lyrics_label.set_markup('\n'.join(lines))

    @staticmethod
    def _fmt_time(seconds):
        """秒数格式化为 m:ss。"""
        try:
            seconds = int(seconds)
        except (TypeError, ValueError):
            seconds = 0
        m = seconds // 60
        s = seconds % 60
        return f"{m}:{s:02d}"

    # ------------------------------------------------------------------ #
    # UI 事件回调
    # ------------------------------------------------------------------ #
    def _on_track_selected(self, listbox, row):
        """歌单选中：播放对应曲目。"""
        if self._suppress_select or row is None:
            return
        self._play_track(row.get_index())

    def _on_play_pause(self, _btn):
        """播放/暂停切换。"""
        if self.player is None:
            return
        if self.current_track is None:
            if self.tracks:
                self._play_track(0)
            return
        if self.is_playing:
            self.player.set_state(Gst.State.PAUSED)
            self.is_playing = False
            self.play_btn.set_label('播放')
        else:
            self.player.set_state(Gst.State.PLAYING)
            self.is_playing = True
            self.play_btn.set_label('暂停')
        self._emit_status_changed()

    def _on_stop(self, _btn):
        """停止播放。"""
        if self.player is None:
            return
        self.player.set_state(Gst.State.NULL)
        self.is_playing = False
        self.play_btn.set_label('播放')
        self._emit_status_changed()

    def _on_prev(self, _btn):
        """上一首。"""
        if self.tracks and self.current_index > 0:
            self._play_track(self.current_index - 1)

    def _on_next(self, _btn):
        """下一首。"""
        if self.tracks and self.current_index < len(self.tracks) - 1:
            self._play_track(self.current_index + 1)

    def _on_progress_value_changed(self, scale):
        """进度条值变化（用户拖动）：实时更新左侧时间标签。"""
        if self._seek_dragging:
            self.time_label.set_label(self._fmt_time(scale.get_value() // 1000))

    def _on_seek_begin(self, _gesture, _x, _y):
        """开始拖动进度条。"""
        self._seek_dragging = True

    def _on_seek_end(self, _gesture, _x, _y):
        """释放进度条：执行跳转。"""
        self._seek_dragging = False
        if self.player is None or not self.is_playing:
            return
        value = self.progress_bar.get_value()
        if value > 0:
            self.player.seek_simple(
                Gst.Format.TIME, Gst.SeekFlags.FLUSH, int(value * 1_000_000))

    def _on_volume_changed(self, scale):
        """音量调节。"""
        vol = scale.get_value() / 100.0
        self._set_volume(vol)

    # ------------------------------------------------------------------ #
    # GStreamer 总线消息
    # ------------------------------------------------------------------ #
    def _on_eos(self, _bus, _msg):
        """播放结束：切到下一首（在主线程执行）。"""
        GLib.idle_add(self._handle_eos)

    def _handle_eos(self):
        self._on_next(None)
        return False

    def _on_error(self, _bus, msg):
        """GStreamer 错误。"""
        err, dbg = msg.parse_error()
        print(f"GStreamer 错误: {err.message} (debug: {dbg})")
        GLib.idle_add(self._handle_gst_error)

    def _handle_gst_error(self):
        self.is_playing = False
        self.play_btn.set_label('播放')
        self._emit_status_changed()
        return False

    def _on_state_changed(self, _bus, _msg):
        """状态变化（此处不处理，状态由按钮回调统一管理）。"""
        pass

    # ------------------------------------------------------------------ #
    # 音量
    # ------------------------------------------------------------------ #
    def _get_volume(self):
        """获取当前音量（0.0 ~ 1.0）。"""
        if self.player is None:
            return 0.0
        try:
            return float(self.player.get_property('volume'))
        except Exception:
            return 0.0

    def _set_volume(self, vol):
        """设置音量（0.0 ~ 1.0），同步 UI 滑块。"""
        vol = max(0.0, min(1.0, float(vol)))
        if self.player is not None:
            try:
                self.player.set_property('volume', vol)
            except Exception as e:
                print(f"警告：设置音量失败: {e}")
        self.volume_btn.handler_block(self._volume_handler_id)
        self.volume_btn.set_value(vol * 100)
        self.volume_btn.handler_unblock(self._volume_handler_id)

    def _get_status_string(self):
        """返回当前播放状态字符串：playing / paused / stopped。"""
        if self.player is None:
            return 'stopped'
        try:
            _ret, state, _pending = self.player.get_state(0)
            if state == Gst.State.PLAYING:
                return 'playing'
            if state == Gst.State.PAUSED:
                return 'paused'
        except Exception:
            pass
        return 'stopped'

    # ------------------------------------------------------------------ #
    # 外部文件播放（命令行 <file.jnl>）
    # ------------------------------------------------------------------ #
    def _play_external_file(self, file_arg):
        """播放不在音乐库中的 .jnl 文件：临时添加到列表尾部。"""
        target = Path(file_arg)
        for i, t in enumerate(self.tracks):
            if t.path == target:
                self._play_track(i)
                return False
        try:
            track = JnlTrack(target)
        except Exception as e:
            print(f"错误：无法打开 {target}: {e}")
            return False
        self.tracks.append(track)
        label_text = f"{len(self.tracks)}. {track.title} - {track.artist}"
        row = Gtk.ListBoxRow()
        row.set_child(Gtk.Label(label=label_text, halign=Gtk.Align.START,
                                margin_start=6, margin_end=6,
                                margin_top=3, margin_bottom=3))
        self.track_list.append(row)
        self._play_track(len(self.tracks) - 1)
        return False

    # ------------------------------------------------------------------ #
    # DBus 服务
    # ------------------------------------------------------------------ #
    def _start_dbus(self):
        """在 GApplication 已拥有的连接上注册 org.jnl_os.Player 接口。
        GApplication 本身已持有 well-known 名称 org.jnl_os.Player，
        因此无需再调用 bus_own_name，避免名称冲突。
        """
        try:
            connection = self.get_dbus_connection()
            if connection is None:
                print("警告：无法获取 DBus 连接")
                return
            node_info = Gio.DBusNodeInfo.new_for_xml(DBUS_INTROSPECTION_XML)
            interface_info = node_info.interfaces[0]
            self._dbus_connection = connection
            self._dbus_reg_id = connection.register_object_with_closures(
                '/org/jnl_os/Player',
                interface_info,
                self._on_dbus_method_call,
                self._on_dbus_get_property,
                None,
            )
            print("DBus 服务已注册: org.jnl_os.Player @ /org/jnl_os/Player")
        except Exception as e:
            print(f"警告：DBus 注册失败: {e}")
            self._dbus_connection = None

    def _on_dbus_method_call(self, connection, sender, object_path,
                            interface_name, method_name, parameters, invocation):
        """DBus 方法调用分发。"""
        try:
            if method_name == 'Play':
                self.dbus_play()
                invocation.return_value(None)
            elif method_name == 'Pause':
                self.dbus_pause()
                invocation.return_value(None)
            elif method_name == 'Next':
                self._on_next(None)
                invocation.return_value(None)
            elif method_name == 'Previous':
                self._on_prev(None)
                invocation.return_value(None)
            elif method_name == 'Stop':
                self._on_stop(None)
                invocation.return_value(None)
            elif method_name == 'PlayTrack':
                idx = parameters.unpack()[0]
                if 0 <= idx < len(self.tracks):
                    self._play_track(idx)
                    invocation.return_value(None)
                else:
                    invocation.return_dbus_error(
                        'org.jnl_os.Player.Error.InvalidIndex',
                        f'索引越界: {idx}')
            elif method_name == 'GetStatus':
                status = self._get_status_string()
                pos_ms = 0
                dur_ms = 0
                if self.player is not None:
                    ok, pos = self.player.query_position(Gst.Format.TIME)
                    if ok:
                        pos_ms = pos // 1_000_000
                    ok, dur = self.player.query_duration(Gst.Format.TIME)
                    if ok:
                        dur_ms = dur // 1_000_000
                invocation.return_value(
                    GLib.Variant('(sii)', (status, pos_ms, dur_ms)))
            elif method_name == 'GetSongInfo':
                if self.current_track:
                    title = self.current_track.title
                    artist = self.current_track.artist
                    album = self.current_track.album
                    dur = self.current_track.duration_sec
                else:
                    title = artist = album = ''
                    dur = 0
                invocation.return_value(
                    GLib.Variant('(sssi)', (title, artist, album, dur)))
            elif method_name == 'SetVolume':
                vol = parameters.unpack()[0]
                self._set_volume(vol)
                invocation.return_value(None)
            elif method_name == 'GetVolume':
                invocation.return_value(
                    GLib.Variant('(d)', (self._get_volume(),)))
            else:
                invocation.return_dbus_error(
                    'org.jnl_os.Player.Error.UnknownMethod',
                    f'未知方法: {method_name}')
        except Exception as e:
            invocation.return_dbus_error(
                'org.jnl_os.Player.Error', str(e))

    def _on_dbus_get_property(self, _connection, _sender, _object_path,
                              _interface_name, property_name):
        """DBus 属性读取。"""
        if property_name == 'Volume':
            return GLib.Variant('d', self._get_volume())
        if property_name == 'Status':
            return GLib.Variant('s', self._get_status_string())
        return None

    def dbus_play(self):
        """DBus Play：播放或恢复。"""
        if self.player is None:
            return
        if self.current_track is None:
            if self.tracks:
                self._play_track(0)
            return
        if not self.is_playing:
            self.player.set_state(Gst.State.PLAYING)
            self.is_playing = True
            self.play_btn.set_label('暂停')
            self._emit_status_changed()

    def dbus_pause(self):
        """DBus Pause：暂停。"""
        if self.player is None or self.current_track is None:
            return
        if self.is_playing:
            self.player.set_state(Gst.State.PAUSED)
            self.is_playing = False
            self.play_btn.set_label('播放')
            self._emit_status_changed()

    def _emit_song_changed(self):
        """发送 SongChanged 信号。"""
        if self._dbus_connection is None:
            return
        if self.current_track:
            title = self.current_track.title
            artist = self.current_track.artist
        else:
            title = artist = ''
        try:
            self._dbus_connection.emit_signal(
                None, '/org/jnl_os/Player', 'org.jnl_os.Player',
                'SongChanged', GLib.Variant('(ss)', (title, artist)))
        except Exception as e:
            print(f"警告：发送 SongChanged 信号失败: {e}")

    def _emit_status_changed(self):
        """发送 StatusChanged 信号。"""
        if self._dbus_connection is None:
            return
        try:
            self._dbus_connection.emit_signal(
                None, '/org/jnl_os/Player', 'org.jnl_os.Player',
                'StatusChanged',
                GLib.Variant('(s)', (self._get_status_string(),)))
        except Exception as e:
            print(f"警告：发送 StatusChanged 信号失败: {e}")

    # ------------------------------------------------------------------ #
    # 退出清理
    # ------------------------------------------------------------------ #
    def do_shutdown(self):
        """应用退出：停止播放并清理所有临时目录。"""
        try:
            if self._lyrics_update_id:
                GLib.source_remove(self._lyrics_update_id)
                self._lyrics_update_id = None
            if self.player is not None:
                self.player.set_state(Gst.State.NULL)
            for t in self.tracks:
                t.cleanup()
        except Exception as e:
            print(f"警告：退出清理失败: {e}")
        finally:
            Gtk.Application.do_shutdown(self)


def main():
    app = JnlpApplication()
    return app.run(sys.argv)


if __name__ == '__main__':
    sys.exit(main())

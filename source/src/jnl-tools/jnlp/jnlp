        btn_box.append(self.play_btn)
        btn_box.append(self.next_btn)
        btn_box.append(self.stop_btn)
        ctrl_box.append(btn_box)

        # 进度条
        progress_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)

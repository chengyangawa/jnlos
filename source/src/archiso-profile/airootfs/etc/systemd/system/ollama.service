[Unit]
Description=Ollama AI Service
After=network.target

[Service]
Type=simple
User=jnluser
Environment="HOME=/home/jnluser"
Environment="OLLAMA_HOST=0.0.0.0"
Environment="OLLAMA_ORIGINS=*"
ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

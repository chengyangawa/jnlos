# 页面 2：语言和键盘
# ============================================================================
class LanguagePage(Gtk.Box):
    def __init__(self, wizard):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.wizard = wizard
        self.lang_combo = None
        self.kb_combo = None

    def build(self):
        for child in self.get_children():
            self.remove(child)

        title = Gtk.Label()
        title.set_markup(f"<span size='x-large' weight='bold' foreground='{XP_BLUE_DARK}'>语言和键盘</span>")
        title.set_halign(Gtk.Align.START)
        self.pack_start(title, False, False, 8)

        # 语言部分
        lang_label = Gtk.Label(label="请选择安装过程中使用的语言：")
        lang_label.set_halign(Gtk.Align.START)
        lang_label.get_style_context().add_class("xp-label-section")
        self.pack_start(lang_label, False, False, 4)

        self.lang_combo = Gtk.ComboBoxText()
        languages = [
            ("zh_CN.UTF-8", "简体中文 (Simplified Chinese)"),
            ("zh_TW.UTF-8", "繁體中文 (Traditional Chinese)"),
            ("en_US.UTF-8", "English (United States)"),
            ("ja_JP.UTF-8", "日本語 (Japanese)"),
            ("ko_KR.UTF-8", "한국어 (Korean)"),
        ]
        for code, name in languages:
            self.lang_combo.append(code, name)
        self.lang_combo.set_active_id("zh_CN.UTF-8")
        self.lang_combo.get_style_context().add_class("xp-entry")
        self.pack_start(self.lang_combo, False, False, 4)

        # 键盘部分
        kb_spacer = Gtk.Box()
        kb_spacer.set_size_request(-1, 12)
        self.pack_start(kb_spacer, False, False, 0)

        kb_label = Gtk.Label(label="请选择键盘布局：")
        kb_label.set_halign(Gtk.Align.START)
        kb_label.get_style_context().add_class("xp-label-section")
        self.pack_start(kb_label, False, False, 4)

        self.kb_combo = Gtk.ComboBoxText()
        keyboards = [
            ("us", "英语（美国）"),
            ("cn", "中文（拼音）"),
            ("jp", "日语"),
            ("kr", "韩语"),
        ]
        for code, name in keyboards:
            self.kb_combo.append(code, name)
        self.kb_combo.set_active_id("us")
        self.kb_combo.get_style_context().add_class("xp-entry")
        self.pack_start(self.kb_combo, False, False, 4)

    def on_enter(self):
        pass

    def on_leave(self):
        self.wizard.state.config["language"] = self.lang_combo.get_active_id() or "zh_CN.UTF-8"
        self.wizard.state.config["keyboard"] = self.kb_combo.get_active_id() or "us"

    def validate(self):
        return True



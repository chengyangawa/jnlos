        summary += f"计算机名:    {cfg.get('hostname', 'JNL-OS')}\n"
        summary += f"用户密码:    {'*' * len(cfg.get('user_password', ''))}\n"
        summary += f"Root 密码:   {'*' * len(cfg.get('root_password', ''))}\n"
        summary += f"\n"
        summary += f"═══════════════════════════════════════\n"
        self.summary_label.set_text(summary)

    def on_leave(self):
        pass

    def validate(self):
        return True



# ============================================================================
# 工具函数
# ============================================================================
def log(msg):
    """写入日志"""
    timestamp = time.strftime("%H:%M:%S")
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(f"[{timestamp}] {msg}\n")
    except Exception:
        pass
    print(f"[{timestamp}] {msg}", flush=True)


def find_install_music():
    """查找安装音乐文件"""
    for path in INSTALL_MUSIC_PATHS:
        if os.path.exists(path) and os.path.getsize(path) > 1000:
            return path
    return None


def run_cmd(cmd, check=True, shell=False, **kwargs):
    """运行命令"""
    try:
        log(f"执行命令: {cmd}")
        if shell:
            result = subprocess.run(cmd, shell=True, check=check,
                                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                    universal_newlines=True, **kwargs)
        else:
            result = subprocess.run(cmd, check=check, shell=False,
                                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                    universal_newlines=True, **kwargs)
        return result.returncode, result.stdout
    except subprocess.CalledProcessError as e:
        return e.returncode, e.stdout
    except Exception as e:
        return -1, str(e)


def get_disks():
    """获取所有磁盘（使用 lsblk）"""
    rc, out = run_cmd(
        "lsblk -ndpo NAME,SIZE,MODEL,TYPE 2>/dev/null | grep -E 'disk$' || "
        "lsblk -ndpo NAME,SIZE,MODEL 2>/dev/null",
        check=False, shell=True
    )
    disks = []
    for line in out.strip().split("\n"):
        if not line:
            continue
        parts = line.split(None, 3)
        if len(parts) >= 2:
            disk = {
                "name": parts[0],
                "size": parts[1] if len(parts) > 1 else "?",
                "model": parts[2] if len(parts) > 2 else "通用磁盘",
                "type": parts[3] if len(parts) > 3 else "disk"
            }
            # 跳过 loop、rom、zram 等
            if any(disk["name"].startswith(x) for x in
                   ["/dev/loop", "/dev/rom", "/dev/zram", "/dev/dm-", "/dev/ram"]):
                continue
            disks.append(disk)
    return disks


def get_partitions(disk):
    """获取磁盘上的所有分区"""
    rc, out = run_cmd(
        f"lsblk -npo NAME,SIZE,FSTYPE,TYPE 2>/dev/null | grep -E '{re.escape(disk)}[0-9]|^{re.escape(disk)}p[0-9]' || true",
        check=False, shell=True
    )
    parts = []
    for line in out.strip().split("\n"):
        if not line:
            continue
        fields = line.split()
        if len(fields) >= 4 and fields[3] == "part":
            parts.append({
                "name": fields[0],
                "size": fields[1],
                "fstype": fields[2] if len(fields) > 2 else "",
            })
    return parts


# ============================================================================
# 音乐播放器
# ============================================================================
class MusicPlayer:
    """简单的音乐播放器，循环播放安装音乐"""

    def __init__(self):
        self.process = None
        self.music_path = None
        self.playing = False

    def _set_low_priority(self):
        """设置低优先级，避免影响安装过程"""
        try:
            os.nice(19)
        except Exception:
            pass

    def start(self):
        """启动循环播放"""
        self.music_path = find_install_music()
        if not self.music_path:
            log("未找到安装音乐文件，跳过播放")
            return False
        log(f"找到安装音乐: {self.music_path}")

        # 尝试不同的播放器（按优先级）
        players = [
            # mpv - 最稳定的选择，使用 nice 降低优先级
            (["nice", "-n", "19", "ionice", "-c", "3", "mpv", "--no-video", "--no-terminal", "--really-quiet", "--loop=inf", "--volume=30", "--audio-buffer=2000", self.music_path], "mpv"),
            # paplay / pacat - PulseAudio
            (["nice", "-n", "19", "paplay", "--loop=9999", self.music_path], "paplay"),
            (["nice", "-n", "19", "pacat", "--loop", self.music_path], "pacat"),
            # mplayer
            (["nice", "-n", "19", "mplayer", "-really-quiet", "-loop", "0", "-volume", "30", "-cache", "2048", self.music_path], "mplayer"),
            # vlc
            (["nice", "-n", "19", "vlc", "--intf", "dummy", "--play-and-exit", "--loop", "--volume", "30", "--no-audio-cache", self.music_path], "vlc"),
            # ffplay
            (["nice", "-n", "19", "ffplay", "-nodisp", "-loglevel", "quiet", "-loop", "0", "-volume", "30", "-fflags", "nobuffer", self.music_path], "ffplay"),
            # cvlc
            (["nice", "-n", "19", "cvlc", "--intf", "dummy", "--play-and-exit", "--loop", "--volume", "30", self.music_path], "cvlc"),
            # gst-launch (gstreamer)
            (["nice", "-n", "19", "gst-launch-1.0", "-q", "playbin", f"uri=file://{self.music_path}", "buffer-size=2000000"], "gst-launch-1.0"),
        ]

        for cmd, name in players:
            try:
                log(f"尝试启动音乐播放器: {name}")
                self.process = subprocess.Popen(
                    cmd,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    preexec_fn=self._set_low_priority
                )
                # 等待播放器启动（最长 3 秒）
                for _ in range(30):
                    time.sleep(0.1)
                    if self.process.poll() is None:
                        log(f"✓ 音乐播放已启动 ({name}, PID: {self.process.pid})")
                        self.playing = True
                        return True
                self.process = None
            except FileNotFoundError:
                log(f"  {name} 未安装")
                continue
            except Exception as e:
                log(f"启动 {name} 失败: {e}")
                continue

        log("所有播放器都不可用，尝试 Python 后备方案")
        return self._start_python_fallback()

    def _start_python_fallback(self):
        """纯 Python 后备播放（需要 pygame）"""
        try:
            import pygame
            pygame.mixer.init()
            pygame.mixer.music.load(self.music_path)
            pygame.mixer.music.set_volume(0.5)
            pygame.mixer.music.play(loops=-1)
            log("✓ 使用 pygame 后备播放")
            self.playing = True
            return True
        except Exception as e:
            log(f"pygame 后备也失败: {e}")
            return False

    def stop(self):
        """停止播放"""
        # 停止 pygame
        try:
            import pygame
            if pygame.mixer.get_init():
                pygame.mixer.music.stop()
        except Exception:
            pass

        # 杀掉外部播放器进程组
        if self.process:
            try:
                os.killpg(os.getpgid(self.process.pid), 15)
            except Exception:
                try:
                    self.process.terminate()
                except Exception:
                    pass
            self.process = None
        self.playing = False
        log("音乐播放已停止")

    def is_playing(self):
        if self.process:
            return self.process.poll() is None
        return self.playing


# ============================================================================
# 安装器状态
# ============================================================================
class InstallerState:
    def __init__(self):
        self.config = {
            "language": "zh_CN.UTF-8",
            "keyboard": "us",
            "install_mode": "auto",  # auto | manual
            "target_disk": "",
            "esp_part": "",
            "root_part": "",
            "home_part": "",
            "username": "jnluser",
            "user_password": "",
            "root_password": "",
            "hostname": "JNL-OS",
            "timezone": "Asia/Shanghai",
        }

    def save(self, path=CONFIG_FILE):
        try:
            with open(path, "w", encoding="utf-8") as f:
                json.dump(self.config, f, indent=2, ensure_ascii=False)
        except Exception as e:
            log(f"保存配置失败: {e}")

    def load(self, path=CONFIG_FILE):
        try:
            with open(path, "r", encoding="utf-8") as f:
                self.config.update(json.load(f))
        except Exception as e:
            log(f"加载配置失败: {e}")


# ============================================================================
# 自定义控件
# ============================================================================
class XPTitleBar(Gtk.Box):
    """Windows XP 风格标题栏"""

    def __init__(self, title, subtitle=""):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.get_style_context().add_class("xp-titlebar")

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_label = Gtk.Label(label=title)
        title_label.set_halign(Gtk.Align.START)
        title_label.get_style_context().add_class("xp-titlebar-title")
        title_box.pack_start(title_label, False, False, 0)

        if subtitle:
            sub_label = Gtk.Label(label=subtitle)
            sub_label.set_halign(Gtk.Align.START)
            sub_label.get_style_context().add_class("xp-titlebar-title")
            sub_label.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.9, 0.95, 1.0, 0.85))
            title_box.pack_start(sub_label, False, False, 0)

        self.pack_start(title_box, True, True, 0)

        # 版本号在右侧
        ver_label = Gtk.Label(label=f"v{APP_VERSION}")
        ver_label.set_halign(Gtk.Align.END)
        ver_label.get_style_context().add_class("xp-titlebar-title")
        ver_label.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.9, 0.95, 1.0, 0.7))
        self.pack_end(ver_label, False, False, 0)


class XPNavBar(Gtk.Box):
    """Windows XP 风格底部导航栏（上一步/下一步/取消）"""

    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.set_halign(Gtk.Align.END)
        self.set_valign(Gtk.Align.END)
        self.set_margin_top(8)
        self.set_margin_bottom(8)
        self.set_margin_end(8)

    def add_button(self, label, primary=False):
        btn = Gtk.Button(label=label)
        if primary:
            btn.get_style_context().add_class("xp-button-primary")
        else:
            btn.get_style_context().add_class("xp-button")
        self.pack_start(btn, False, False, 0)
        return btn


class XPStepIndicator(Gtk.Box):
    """显示当前步骤的进度指示器"""

    def __init__(self, total_steps):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        self.total = total_steps
        self.dots = []
        for i in range(total_steps):
            dot = Gtk.Label(label="●")
            dot.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.5, 0.5, 0.5, 1.0))
            self.dots.append(dot)
            self.pack_start(dot, False, False, 4)

    def set_step(self, step):
        for i, dot in enumerate(self.dots):
            if i < step:
                dot.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.24, 0.36, 0.86, 1.0))
                dot.set_text("✓")
            elif i == step:
                dot.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.24, 0.36, 0.86, 1.0))
                dot.set_text("●")
            else:
                dot.override_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0.6, 0.6, 0.6, 1.0))
                dot.set_text("●")


# ============================================================================
# 安装向导页面
# ============================================================================
class InstallerWizard(Gtk.Window):
    """主安装向导窗口"""

    def __init__(self):
        super().__init__(title=APP_TITLE)
        self.set_default_size(780, 560)
        self.set_resizable(True)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)  # 去掉窗口装饰，自定义标题栏

        self.state = InstallerState()
        self.current_page = 0
        self.music = MusicPlayer()
        self.worker_thread = None
        self.worker_process = None
        self.pages = []
        self.cancel_requested = False

        # 加载 CSS
        self._load_css()

        # 启动音乐（在背景循环播放）
        GLib.idle_add(self._delayed_start_music)

        # 主容器
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        main_box.get_style_context().add_class("xp-window")
        self.add(main_box)

        # 标题栏
        self.titlebar = XPTitleBar(APP_TITLE, "Java Net Lava OS 图形化安装程序")
        main_box.pack_start(self.titlebar, False, False, 0)

        # 内容区（用 Stack 实现多页面切换）
        self.content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.content_box.get_style_context().add_class("xp-content")
        main_box.pack_start(self.content_box, True, True, 0)

        # 步骤指示器
        self.step_indicator = XPStepIndicator(7)
        indicator_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        indicator_box.set_halign(Gtk.Align.CENTER)
        indicator_box.set_margin_top(12)
        indicator_box.set_margin_bottom(8)
        indicator_box.add(self.step_indicator)
        self.content_box.pack_start(indicator_box, False, False, 0)

        # Stack 用于页面切换
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(200)
        self.content_box.pack_start(self.stack, True, True, 0)

        # 底部导航栏
        nav_container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.navbar = XPNavBar()
        nav_container.pack_start(self.navbar, False, False, 0)
        main_box.pack_start(nav_container, False, False, 0)

        # 创建所有页面
        self._build_pages()

        # 创建导航按钮
        self.prev_btn = self.navbar.add_button("上一步 (B)")
        self.next_btn = self.navbar.add_button("下一步 (N)", primary=True)
        cancel_btn = self.navbar.add_button("取消 (C)")

        self.prev_btn.connect("clicked", lambda *_: self._prev_page())
        self.next_btn.connect("clicked", lambda *_: self._next_page())
        cancel_btn.connect("clicked", lambda *_: self._on_cancel())

        # 键盘快捷键
        self.connect("key-press-event", self._on_key_press)

        # 窗口关闭
        self.connect("delete-event", lambda *_: self._on_window_close())

        # 显示第一页
        self._show_page(0)

    def _load_css(self):
        """加载 CSS 样式"""
        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(XP_CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def _delayed_start_music(self):
        """延迟启动音乐（让 UI 先显示）"""
        threading.Thread(target=self.music.start, daemon=True).start()
        return False

    def _build_pages(self):
        """创建所有安装页面"""
        # 第 1 页：欢迎
        self.pages.append(WelcomePage(self))
        # 第 2 页：语言和键盘
        self.pages.append(LanguagePage(self))
        # 第 3 页：许可协议
        self.pages.append(LicensePage(self))
        # 第 4 页：安装类型
        self.pages.append(InstallTypePage(self))
        # 第 5 页：磁盘选择
        self.pages.append(DiskPage(self))
        # 第 6 页：用户配置
        self.pages.append(UserPage(self))
        # 第 7 页：确认
        self.pages.append(ConfirmPage(self))
        # 第 8 页：安装中
        self.pages.append(InstallPage(self))
        # 第 9 页：完成
        self.pages.append(DonePage(self))

        for i, page in enumerate(self.pages):
            page.build()
            self.stack.add_titled(page, f"page{i}", f"第{i+1}页")

    def _show_page(self, idx):
        """切换到指定页面"""
        if idx < 0 or idx >= len(self.pages):
            return
        # 离开当前页面
        if 0 <= self.current_page < len(self.pages):
            self.pages[self.current_page].on_leave()
        # 进入新页面
        self.current_page = idx
        self.stack.set_visible_child_name(f"page{idx}")
        self.pages[idx].on_enter()
        # 更新步骤指示器（只在前面配置步骤显示）
        if idx < 7:
            self.step_indicator.set_step(idx)
            self.step_indicator.set_visible(True)
        else:
            self.step_indicator.set_visible(False)
        # 更新导航按钮
        self._update_nav_buttons()

    def _update_nav_buttons(self):
        """更新导航按钮状态"""
        idx = self.current_page
        if idx == 0:
            self.prev_btn.set_label("退出 (E)")
            self.next_btn.set_label("下一步 (N)")
            self.next_btn.set_sensitive(True)
        elif idx in (1, 2, 3, 4, 5, 6):
            self.prev_btn.set_label("上一步 (B)")
            self.next_btn.set_label("下一步 (N)")
        elif idx == 7:
            # 安装页面
            self.prev_btn.set_sensitive(False)
            self.next_btn.set_sensitive(False)
        elif idx == 8:
            # 完成页面
            self.prev_btn.set_sensitive(False)
            self.next_btn.set_label("重启 (R)")
            self.next_btn.set_sensitive(True)
            self.prev_btn.set_label("")
            self.prev_btn.set_sensitive(False)
        self.show_all()

    def _next_page(self):
        """下一页"""
        idx = self.current_page
        if idx == 8:
            # 完成页：重启
            self._do_reboot()
            return

        # 验证当前页
        if not self.pages[idx].validate():
            return

        if idx == 6:
            # 确认页 → 安装页
            self.state.save()
            self._show_page(7)
            # 启动安装
            GLib.idle_add(self.pages[7].start_install)
            return

        self._show_page(idx + 1)

    def _prev_page(self):
        """上一页"""
        idx = self.current_page
        if idx == 0:
            self._on_cancel()
            return
        self._show_page(idx - 1)

    def _on_key_press(self, widget, event):
        """键盘事件"""
        key = event.keyval
        if key == Gdk.KEY_Escape:
            self._on_cancel()
        elif key in (Gdk.KEY_n, Gdk.KEY_N) and self.next_btn.get_sensitive():
            self._next_page()
        elif key in (Gdk.KEY_b, Gdk.KEY_B) and self.prev_btn.get_sensitive():
            self._prev_page()
        elif key in (Gdk.KEY_c, Gdk.KEY_C):
            self._on_cancel()

    def _on_cancel(self):
        """取消安装"""
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.YES_NO,
            text="确定要取消安装吗？"
        )
        dialog.format_secondary_text("系统将重启回到 Live 环境，您可以重新开始安装。")
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.YES:
            self.music.stop()
            if self.worker_process and self.worker_process.poll() is None:
                try:
                    self.worker_process.terminate()
                except Exception:
                    pass
            Gtk.main_quit()

    def _on_window_close(self, *args):
        self._on_cancel()
        return True

    def _do_reboot(self):
        """执行重启"""
        self.music.stop()
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK,
            text="系统将重启..."
        )
        dialog.format_secondary_text("请先移除 U 盘，然后系统将重启进入新系统。")
        dialog.run()
        dialog.destroy()
        subprocess.Popen(["reboot"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        Gtk.main_quit()



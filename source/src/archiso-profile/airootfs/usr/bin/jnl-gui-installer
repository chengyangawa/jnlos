# 页面 8：安装中
# ============================================================================
class InstallPage(Gtk.Box):
    def __init__(self, wizard):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.wizard = wizard
        self.progress_bar = None
        self.status_label = None
        self.step_label = None
        self.log_view = None
        self.log_buffer = None
        self.current_step = 0
        self.worker_process = None
        self.poll_source_id = None
        self.progress_num1 = None
        self.progress_num2 = None

    def build(self):
        for child in self.get_children():
            self.remove(child)

        title = Gtk.Label()
        title.set_markup(f"<span size='x-large' weight='bold' foreground='{XP_BLUE_DARK}'>正在安装</span>")
        title.set_halign(Gtk.Align.START)
        self.pack_start(title, False, False, 8)

        # 当前步骤标签
        self.step_label = Gtk.Label()
        self.step_label.set_markup(f"<b>准备中...</b>")
        self.step_label.set_halign(Gtk.Align.START)
        self.step_label.get_style_context().add_class("xp-label-section")
        self.pack_start(self.step_label, False, False, 4)

        # 详细状态
        self.status_label = Gtk.Label()
        self.status_label.set_halign(Gtk.Align.START)
        self.status_label.set_markup("<span foreground='#666666' size='small'>等待启动...</span>")
        self.pack_start(self.status_label, False, False, 4)

        # 日志查看器
        log_label = Gtk.Label(label="安装日志：")
        log_label.set_halign(Gtk.Align.START)
        log_label.get_style_context().add_class("xp-label-section")
        self.pack_start(log_label, False, False, 4)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_shadow_type(Gtk.ShadowType.IN)
        scrolled.set_vexpand(True)
        scrolled.set_hexpand(True)

        self.log_view = Gtk.TextView()
        self.log_view.set_editable(False)
        self.log_view.set_cursor_visible(False)
        self.log_view.set_monospace(True)
        self.log_view.get_style_context().add_class("xp-textview")
        self.log_view.set_margin_start(6)
        self.log_view.set_margin_end(6)
        self.log_view.set_margin_top(6)
        self.log_view.set_margin_bottom(6)
        self.log_buffer = self.log_view.get_buffer()
        scrolled.add(self.log_view)
        self.pack_start(scrolled, True, True, 0)

        # 底部进度条区域（Windows 10 风格）
        progress_area = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        progress_area.set_margin_top(8)
        progress_area.set_margin_bottom(4)
        progress_area.set_margin_start(8)
        progress_area.set_margin_end(8)

        # 进度条（加粗）
        self.progress_bar = Gtk.ProgressBar()
        self.progress_bar.set_fraction(0.0)
        self.progress_bar.set_show_text(True)
        self.progress_bar.set_text("0%")
        self.progress_bar.get_style_context().add_class("win10-progress")
        self.progress_bar.set_margin_start(0)
        self.progress_bar.set_margin_end(0)
        progress_area.pack_start(self.progress_bar, False, False, 0)

        # 进度条下方的数字标记（Windows 10 风格）
        num_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        num_box.set_size_request(-1, 24)

        # 数字 1（在 0% 位置）
        self.progress_num1 = Gtk.Label()
        self.progress_num1.set_markup("<span size='xx-large' weight='bold' foreground='#0078D7'>1</span>")
        self.progress_num1.set_halign(Gtk.Align.START)
        self.progress_num1.set_valign(Gtk.Align.CENTER)
        num_box.pack_start(self.progress_num1, False, False, 0)

        # 填充空间
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        num_box.pack_start(spacer, True, True, 0)

        # 数字 2（在 30% 位置，通过占位调整）
        self.progress_num2 = Gtk.Label()
        self.progress_num2.set_markup("<span size='xx-large' weight='bold' foreground='#666666'>2</span>")
        self.progress_num2.set_halign(Gtk.Align.START)
        self.progress_num2.set_valign(Gtk.Align.CENTER)
        num_box.pack_start(self.progress_num2, False, False, 0)

        progress_area.pack_start(num_box, False, False, 0)

        self.pack_start(progress_area, False, False, 0)

    def start_install(self):
        """启动安装（在主线程调用）"""
        # 保存配置
        self.wizard.state.save()

        # 启动 worker 进程
        worker_script = "/usr/bin/jnl-installer-worker"
        if not os.path.exists(worker_script):
            self._append_log(f"错误：未找到 worker 脚本 {worker_script}\n")
            self._set_step(-1, f"错误：未找到 worker 脚本")
            return

        self._append_log("=" * 60 + "\n")
        self._append_log(f"Java Net Lava OS 安装程序 v{APP_VERSION}\n")
        self._append_log(f"启动时间: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
        self._append_log("=" * 60 + "\n")
        self._append_log(f"配置文件: {CONFIG_FILE}\n")
        self._append_log(f"日志文件: {LOG_FILE}\n")
        self._append_log(f"Worker 脚本: {worker_script}\n\n")

        try:
            self.worker_process = subprocess.Popen(
                ["pkexec", worker_script, CONFIG_FILE],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                universal_newlines=True,
                bufsize=1
            )
        except FileNotFoundError:
            # 如果没有 pkexec，尝试 sudo
            try:
                self.worker_process = subprocess.Popen(
                    ["sudo", "-A", worker_script, CONFIG_FILE],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    universal_newlines=True,
                    bufsize=1
                )
            except Exception as e:
                self._append_log(f"启动失败：{e}\n尝试直接执行...\n")
                self.worker_process = subprocess.Popen(
                    [worker_script, CONFIG_FILE],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    universal_newlines=True,
                    bufsize=1
                )

        # 写入 PID
        with open(WORKER_PID_FILE, "w") as f:
            f.write(str(self.worker_process.pid))

        self._append_log(f"Worker 进程已启动 (PID: {self.worker_process.pid})\n\n")

        # 启动轮询
        self.poll_source_id = GLib.timeout_add(300, self._poll_worker)

    def _poll_worker(self):
        """轮询 worker 输出"""
        if not self.worker_process:
            return False

        # 读取所有可用输出
        try:
            while True:
                line = self.worker_process.stdout.readline()
                if not line:
                    break
                self._append_log(line)
                # 解析状态行
                self._parse_status(line)
        except Exception:
            pass

        # 检查进程是否结束
        ret = self.worker_process.poll()
        if ret is not None:
            self._append_log(f"\n[Worker 进程已结束，退出码: {ret}]\n")
            if ret == 0:
                self._set_step(len(STEPS) - 1, "安装完成！")
                # 延迟跳转到完成页
                GLib.timeout_add_seconds(2, lambda: self._goto_done() or False)
            else:
                self._set_step(-1, f"安装失败（退出码: {ret}）")
            return False  # 停止轮询

        return True  # 继续轮询

    def _parse_status(self, line):
        """解析状态行（worker 输出的 STEP|PERCENT|STATUS 格式）"""
        line = line.strip()
        if line.startswith("STEP|"):
            try:
                parts = line.split("|", 2)
                step_idx = int(parts[1])
                status = parts[2] if len(parts) > 2 else ""
                self._set_step(step_idx, status)
            except Exception:
                pass

    def _set_step(self, step_idx, status_text=""):
        """设置当前步骤"""
        if step_idx < 0:
            self.step_label.set_markup(f"<b><span foreground='red'>{status_text}</span></b>")
            return
        if step_idx >= len(STEPS):
            step_idx = len(STEPS) - 1
        step_name, step_desc, percent = STEPS[step_idx]
        self.progress_bar.set_fraction(percent / 100.0)
        self.progress_bar.set_text(f"{percent}%")
        if status_text:
            self.step_label.set_markup(f"<b>{step_desc}</b> - {status_text}")
        else:
            self.step_label.set_markup(f"<b>{step_desc}</b>")
        self.status_label.set_markup(
            f"<span foreground='#666666' size='small'>步骤 {step_idx + 1}/{len(STEPS)} - {step_name}</span>"
        )

        # 更新数字标记颜色（Windows 10 风格）
        if percent <= 30:
            self.progress_num1.set_markup("<span size='xx-large' weight='bold' foreground='#0078D7'>1</span>")
            self.progress_num2.set_markup("<span size='xx-large' weight='bold' foreground='#666666'>2</span>")
        else:
            self.progress_num1.set_markup("<span size='xx-large' weight='bold' foreground='#0078D7'>1</span>")
            self.progress_num2.set_markup("<span size='xx-large' weight='bold' foreground='#0078D7'>2</span>")

    def _append_log(self, text):
        """追加日志"""
        end_iter = self.log_buffer.get_end_iter()
        self.log_buffer.insert(end_iter, text)
        # 自动滚动到底部
        mark = self.log_buffer.create_mark(None, self.log_buffer.get_end_iter(), False)
        self.log_view.scroll_to_mark(mark, 0.0, True, 0.0, 1.0)

    def _goto_done(self):
        """跳转到完成页面"""
        # 检查安装是否真的成功
        if os.path.exists("/tmp/jnl-install-complete"):
            self.wizard._show_page(8)
        else:
            self._set_step(-1, "安装未完成，请查看日志")
        return False

    def on_enter(self):
        pass

    def on_leave(self):
        pass

    def validate(self):
        return True


# ============================================================================
# 页面 9：完成
# ============================================================================
class DonePage(Gtk.Box):
    def __init__(self, wizard):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.wizard = wizard

    def build(self):
        for child in self.get_children():
            self.remove(child)

        # 居中
        spacer_top = Gtk.Box()
        spacer_top.set_size_request(-1, 30)
        self.pack_start(spacer_top, False, False, 0)

        # 大标题
        title = Gtk.Label()
        title.set_markup(
            f"<span size='xx-large' weight='bold' foreground='{XP_GREEN}'>✓ 安装完成</span>"
        )
        self.pack_start(title, False, False, 12)

        # 副标题
        subtitle = Gtk.Label()
        subtitle.set_markup(
            f"<span size='large' foreground='#444444'>Java Net Lava OS 已成功安装到您的计算机</span>"
        )
        self.pack_start(subtitle, False, False, 4)

        # 装饰条
        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        self.pack_start(sep, False, False, 12)

        # 信息
        info_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        info_box.set_margin_start(20)
        info_box.set_margin_end(20)
        info_box.set_margin_top(10)
        info_box.set_margin_bottom(10)

        lines = [
            ("系统版本:", f"Java Net Lava OS {APP_VERSION}"),
            ("用户名:", None),  # 动态填充
            ("计算机名:", None),
            ("", ""),
            ("后续步骤:", ""),
            ("1. 移除 U 盘", ""),
            ("2. 点击「重启」按钮", ""),
            ("3. 系统将从硬盘启动进入新系统", ""),
        ]
        self.info_labels = {}
        for label, value in lines:
            if not label and not value:
                spacer = Gtk.Box()
                spacer.set_size_request(-1, 8)
                info_box.pack_start(spacer, False, False, 0)
                continue
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            l = Gtk.Label(label=label)
            l.set_halign(Gtk.Align.START)
            l.set_size_request(100, -1)
            l.get_style_context().add_class("xp-label")
            row.pack_start(l, False, False, 0)

            v = Gtk.Label(label=value or "")
            v.set_halign(Gtk.Align.START)
            v.set_line_wrap(True)
            v.get_style_context().add_class("xp-label")
            row.pack_start(v, True, True, 0)

            info_box.pack_start(row, False, False, 0)
            self.info_labels[label] = v

        self.pack_start(info_box, True, True, 0)

        # 提示
        hint = Gtk.Label()
        hint.set_markup(
            f"<b><span foreground='red' size='large'>⚠ 请先移除 U 盘！</span></b>"
        )
        self.pack_start(hint, False, False, 12)

    def on_enter(self):
        cfg = self.wizard.state.config
        if "用户名:" in self.info_labels:
            self.info_labels["用户名:"].set_text(cfg.get("username", "jnluser"))
        if "计算机名:" in self.info_labels:
            self.info_labels["计算机名:"].set_text(cfg.get("hostname", "JNL-OS"))

    def on_leave(self):
        pass

    def validate(self):
        return True


# ============================================================================
# 主程序
# ============================================================================
def main():
    # 检查 root 权限
    if os.geteuid() != 0:
        # 尝试用 pkexec / sudo 重启
        for cmd in (["pkexec", sys.executable] + sys.argv,
                    ["sudo", sys.executable] + sys.argv):
            try:
                os.execvp(cmd[0], cmd)
            except FileNotFoundError:
                continue
            except Exception:
                pass
        print("错误：需要 root 权限运行安装程序")
        sys.exit(1)

    # 设置环境
    os.environ.setdefault("DISPLAY", ":0")
    os.environ.setdefault("LANG", "zh_CN.UTF-8")
    os.environ.setdefault("LC_ALL", "zh_CN.UTF-8")

    # 清理旧的标记文件
    for f in ["/tmp/jnl-install-complete", WORKER_PID_FILE]:
        try:
            os.remove(f)
        except FileNotFoundError:
            pass

    # 启动 GTK
    win = InstallerWizard()
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()

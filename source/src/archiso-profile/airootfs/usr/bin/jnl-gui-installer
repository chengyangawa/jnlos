        for child in self.get_children():
            self.remove(child)

        # 顶部留白
        spacer = Gtk.Box()
        spacer.set_size_request(-1, 20)
        self.pack_start(spacer, False, False, 0)

        # 主标题
        title = Gtk.Label()
        title.set_markup(f"<span size='xx-large' weight='bold' foreground='{XP_BLUE_DARK}'>欢迎使用 Java Net Lava OS</span>")
        self.pack_start(title, False, False, 8)

        subtitle = Gtk.Label()
        subtitle.set_markup(f"<span size='large' foreground='#444444'>版本 {APP_VERSION} - 图形化安装向导</span>")
        self.pack_start(subtitle, False, False, 4)

        # 装饰条
        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        self.pack_start(sep, False, False, 8)

        # 介绍文字
        desc_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        desc_box.set_margin_start(20)
        desc_box.set_margin_end(20)
        desc_box.set_margin_top(10)
        desc_box.set_margin_bottom(10)

        lines = [
            "本安装程序将引导您完成 Java Net Lava OS 的安装过程。",
            "",
            "安装过程包括以下步骤：",
            "   1. 选择语言和键盘布局",
            "   2. 阅读并接受许可协议",
            "   3. 选择安装类型（自动/手动）",
            "   4. 选择目标磁盘和分区",
            "   5. 配置用户账户",
            "   6. 确认安装并开始安装",
            "",
            "整个过程通常需要 5-15 分钟（取决于磁盘速度）。",
            "安装过程中将循环播放安装音乐。",
        ]
        for line in lines:
            label = Gtk.Label(label=line)
            label.set_halign(Gtk.Align.START)
            label.get_style_context().add_class("xp-label")
            desc_box.pack_start(label, False, False, 0)

        self.pack_start(desc_box, True, True, 0)

        # 提示
        hint = Gtk.Label()
        hint.set_markup(f"<i>点击「下一步」继续。安装前请确保已备份重要数据。</i>")
        self.pack_start(hint, False, False, 12)

    def on_enter(self):
        pass

    def on_leave(self):
        pass

    def validate(self):
        return True



# ============================================================================
# 页面 5：磁盘选择
# ============================================================================
class DiskPage(Gtk.Box):
    def __init__(self, wizard):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.wizard = wizard
        self.disks = []
        self.parts = []
        self.disk_radio_buttons = []
        self.esp_combo = None
        self.root_combo = None
        self.home_combo = None
        self.mode_label = None
        self.refresh_btn = None

    def build(self):
        for child in self.get_children():
            self.remove(child)

        title = Gtk.Label()
        title.set_markup(f"<span size='x-large' weight='bold' foreground='{XP_BLUE_DARK}'>选择磁盘</span>")
        title.set_halign(Gtk.Align.START)
        self.pack_start(title, False, False, 8)

        # 加载磁盘
        self._load_disks()

        # 模式标签
        self.mode_label = Gtk.Label()
        mode = self.wizard.state.config.get("install_mode", "auto")
        if mode == "auto":
            self.mode_label.set_markup(f"<b>模式：全新安装（自动分区）</b>")
        else:
            self.mode_label.set_markup(f"<b>模式：手动安装（选择已有分区）</b>")
        self.mode_label.set_halign(Gtk.Align.START)
        self.mode_label.get_style_context().add_class("xp-label-section")
        self.pack_start(self.mode_label, False, False, 4)

        if mode == "auto":
            self._build_auto_ui()
        else:
            self._build_manual_ui()

    def _load_disks(self):
        """加载磁盘和分区信息"""
        self.disks = get_disks()
        self.parts = []
        for disk in self.disks:
            for part in get_partitions(disk["name"]):
                self.parts.append(part)
        log(f"检测到 {len(self.disks)} 个磁盘，{len(self.parts)} 个分区")

    def _build_auto_ui(self):
        """构建自动安装界面"""
        if not self.disks:
            err = Gtk.Label(label="未检测到任何磁盘！")
            err.get_style_context().add_class("xp-label")
            self.pack_start(err, True, True, 0)
            return

        warn = Gtk.Label()
        warn.set_markup(
            f"<b><span foreground='red' size='large'>⚠ 警告</span></b><br/>"
            f"<span foreground='red'>所选磁盘上的所有数据将被永久删除！请确保已备份重要数据。</span>"
        )
        warn.set_halign(Gtk.Align.START)
        self.pack_start(warn, False, False, 8)

        label = Gtk.Label(label="请选择要安装系统的磁盘：")
        label.set_halign(Gtk.Align.START)
        label.get_style_context().add_class("xp-label-section")
        self.pack_start(label, False, False, 4)

        # 磁盘列表
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_shadow_type(Gtk.ShadowType.IN)
        scrolled.set_vexpand(True)
        scrolled.set_hexpand(True)

        listbox = Gtk.ListBox()
        listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.disk_radio_buttons = []

        for disk in self.disks:
            row = Gtk.ListBoxRow()
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            box.set_margin_start(8)
            box.set_margin_end(8)
            box.set_margin_top(8)
            box.set_margin_bottom(8)

            radio = Gtk.RadioButton.new_with_label(None, "")
            radio.set_size_request(20, 20)
            if not self.disk_radio_buttons:
                radio.set_active(True)
            else:
                radio.join_group(self.disk_radio_buttons[0])
            self.disk_radio_buttons.append(radio)
            box.pack_start(radio, False, False, 0)

            text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            name_label = Gtk.Label()
            name_label.set_markup(f"<b>{disk['name']}</b>")
            name_label.set_halign(Gtk.Align.START)
            text_box.pack_start(name_label, False, False, 0)

            info_label = Gtk.Label()
            info_label.set_markup(f"<span foreground='#666666' size='small'>大小: {disk['size']}  |  型号: {disk['model']}</span>")
            info_label.set_halign(Gtk.Align.START)
            text_box.pack_start(info_label, False, False, 0)
            box.pack_start(text_box, True, True, 0)

            row.add(box)
            listbox.add(row)

        scrolled.add(listbox)
        self.pack_start(scrolled, True, True, 0)

    def _build_manual_ui(self):
        """构建手动安装界面"""
        if not self.parts:
            err = Gtk.Label()
            err.set_markup(
                f"<b><span foreground='red'>未检测到任何分区！</span></b>\n"
                f"<span foreground='#666666'>请先用 GParted 等工具创建 ESP（FAT32, ≥512MB）和根分区（ext4, ≥10GB）。</span>"
            )
            err.get_style_context().add_class("xp-label")
            err.set_halign(Gtk.Align.START)
            self.pack_start(err, True, True, 0)
            return

        # ESP 选择
        esp_label = Gtk.Label(label="EFI 引导分区 (FAT32, ≥512MB):")
        esp_label.set_halign(Gtk.Align.START)
        esp_label.get_style_context().add_class("xp-label-section")
        self.pack_start(esp_label, False, False, 4)
        self.esp_combo = Gtk.ComboBoxText()
        for part in self.parts:
            label = f"{part['name']} ({part['size']}, {part['fstype'] or '未格式化'})"
            self.esp_combo.append(part['name'], label)
        self.esp_combo.get_style_context().add_class("xp-entry")
        self.pack_start(self.esp_combo, False, False, 4)

        spacer1 = Gtk.Box()
        spacer1.set_size_request(-1, 12)
        self.pack_start(spacer1, False, False, 0)

        # 根分区选择
        root_label = Gtk.Label(label="根分区 / (ext4, ≥10GB):")
        root_label.set_halign(Gtk.Align.START)
        root_label.get_style_context().add_class("xp-label-section")
        self.pack_start(root_label, False, False, 4)
        self.root_combo = Gtk.ComboBoxText()
        for part in self.parts:
            label = f"{part['name']} ({part['size']}, {part['fstype'] or '未格式化'})"
            self.root_combo.append(part['name'], label)
        self.root_combo.get_style_context().add_class("xp-entry")
        self.pack_start(self.root_combo, False, False, 4)

        spacer2 = Gtk.Box()
        spacer2.set_size_request(-1, 12)
        self.pack_start(spacer2, False, False, 0)

        # home 分区选择（可选）
        home_label = Gtk.Label(label="Home 分区（可选，独立分区时选择）:")
        home_label.set_halign(Gtk.Align.START)
        home_label.get_style_context().add_class("xp-label-section")
        self.pack_start(home_label, False, False, 4)
        self.home_combo = Gtk.ComboBoxText()
        self.home_combo.append("", "（不使用，/home 在根分区上）")
        for part in self.parts:
            label = f"{part['name']} ({part['size']}, {part['fstype'] or '未格式化'})"
            self.home_combo.append(part['name'], label)
        self.home_combo.set_active_id("")
        self.home_combo.get_style_context().add_class("xp-entry")
        self.pack_start(self.home_combo, False, False, 4)

    def on_enter(self):
        # 如果模式变了，重新构建界面
        current_mode = "auto" if self.auto_radio and self.auto_radio.get_active() else "manual"
        # 简单处理：每次进入都重建
        self.build()

    def on_leave(self):
        mode = self.wizard.state.config.get("install_mode", "auto")
        if mode == "auto":
            # 找到选中的磁盘
            for i, radio in enumerate(self.disk_radio_buttons):
                if i < len(self.disks) and radio.get_active():
                    self.wizard.state.config["target_disk"] = self.disks[i]["name"]
                    break
        else:
            if self.esp_combo:
                self.wizard.state.config["esp_part"] = self.esp_combo.get_active_id() or ""
            if self.root_combo:
                self.wizard.state.config["root_part"] = self.root_combo.get_active_id() or ""
            if self.home_combo:
                self.wizard.state.config["home_part"] = self.home_combo.get_active_id() or ""

    def validate(self):
        mode = self.wizard.state.config.get("install_mode", "auto")
        if mode == "auto":
            target = self.wizard.state.config.get("target_disk", "")
            if not target:
                dialog = Gtk.MessageDialog(
                    transient_for=self.wizard,
                    modal=True,
                    message_type=Gtk.MessageType.WARNING,
                    buttons=Gtk.ButtonsType.OK,
                    text="请选择目标磁盘"
                )
                dialog.run()
                dialog.destroy()
                return False
            # 大小检查
            for disk in self.disks:
                if disk["name"] == target:
                    size_str = disk["size"]
                    # 解析大小（支持 K/M/G/T）
                    m = re.match(r"([\d.]+)([KMGT]?)", size_str.upper())
                    if m:
                        num = float(m.group(1))
                        unit = m.group(2) or ""
                        mult = {"": 1, "K": 1024, "M": 1024**2, "G": 1024**3, "T": 1024**4}[unit]
                        size_bytes = int(num * mult)
                        if size_bytes < 10 * 1024**3:
                            dialog = Gtk.MessageDialog(
                                transient_for=self.wizard,
                                modal=True,
                                message_type=Gtk.MessageType.WARNING,
                                buttons=Gtk.ButtonsType.OK,
                                text="磁盘空间不足"
                            )
                            dialog.format_secondary_text(f"磁盘 {target} 大小仅 {size_str}，至少需要 10GB。")
                            dialog.run()
                            dialog.destroy()
                            return False
        else:
            esp = self.wizard.state.config.get("esp_part", "")
            root = self.wizard.state.config.get("root_part", "")
            if not esp or not root:
                dialog = Gtk.MessageDialog(
                    transient_for=self.wizard,
                    modal=True,
                    message_type=Gtk.MessageType.WARNING,
                    buttons=Gtk.ButtonsType.OK,
                    text="请选择必要的分区"
                )
                dialog.format_secondary_text("必须选择 ESP 引导分区和根分区。")
                dialog.run()
                dialog.destroy()
                return False
        return True


# ============================================================================
# 页面 6：用户配置
# ============================================================================
class UserPage(Gtk.Box):
    def __init__(self, wizard):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.wizard = wizard
        self.username_entry = None
        self.userpass_entry = None
        self.userpass2_entry = None
        self.rootpass_entry = None
        self.rootpass2_entry = None
        self.hostname_entry = None

    def build(self):
        for child in self.get_children():
            self.remove(child)

        title = Gtk.Label()
        title.set_markup(f"<span size='x-large' weight='bold' foreground='{XP_BLUE_DARK}'>用户配置</span>")
        title.set_halign(Gtk.Align.START)
        self.pack_start(title, False, False, 8)

        desc = Gtk.Label()
        desc.set_markup("创建您的账户信息和计算机名：")
        desc.set_halign(Gtk.Align.START)
        desc.get_style_context().add_class("xp-label")
        self.pack_start(desc, False, False, 4)

        # 用户名
        self._add_field("用户名:", "username_entry", "jnluser")
        # 用户密码
        self._add_field("用户密码:", "userpass_entry", "", password=True)
        self._add_field("确认密码:", "userpass2_entry", "", password=True)
        # 主机名
        self._add_field("计算机名:", "hostname_entry", "JNL-OS")
        # Root 密码
        self._add_field("Root 密码:", "rootpass_entry", "", password=True)
        self._add_field("确认 Root 密码:", "rootpass2_entry", "", password=True)

        hint = Gtk.Label()
        hint.set_markup(f"<i><span foreground='#666666' size='small'>提示：密码至少 6 个字符。如果不设置 Root 密码，将使用用户密码。</span></i>")
        hint.set_halign(Gtk.Align.START)
        hint.set_margin_top(8)
        self.pack_start(hint, False, False, 0)

    def _add_field(self, label_text, attr_name, default="", password=False):
        label = Gtk.Label(label=label_text)
        label.set_halign(Gtk.Align.START)
        label.set_margin_top(4)
        label.get_style_context().add_class("xp-label-section")
        self.pack_start(label, False, False, 0)

        if password:
            entry = Gtk.Entry()
            entry.set_visibility(False)
        else:
            entry = Gtk.Entry()
        entry.set_text(default)
        entry.get_style_context().add_class("xp-entry")
        self.pack_start(entry, False, False, 0)
        setattr(self, attr_name, entry)

    def on_enter(self):
        pass

    def on_leave(self):
        self.wizard.state.config["username"] = self.username_entry.get_text().strip() or "jnluser"
        self.wizard.state.config["user_password"] = self.userpass_entry.get_text()
        self.wizard.state.config["root_password"] = self.rootpass_entry.get_text() or self.wizard.state.config["user_password"]
        self.wizard.state.config["hostname"] = self.hostname_entry.get_text().strip() or "JNL-OS"

    def validate(self):
        username = self.username_entry.get_text().strip()
        userpass = self.userpass_entry.get_text()
        userpass2 = self.userpass2_entry.get_text()
        rootpass = self.rootpass_entry.get_text() or userpass
        rootpass2 = self.rootpass2_entry.get_text() or rootpass
        hostname = self.hostname_entry.get_text().strip()

        if not username:
            self._show_error("请输入用户名")
            return False
        if not re.match(r"^[a-z_][a-z0-9_-]{0,31}$", username):
            self._show_error("用户名只能包含小写字母、数字、下划线和连字符，且必须以字母或下划线开头")
            return False

        if len(userpass) < 6:
            self._show_error("用户密码至少需要 6 个字符")
            return False

        if userpass != userpass2:
            self._show_error("两次输入的用户密码不一致")
            return False

        if len(rootpass) < 6:
            self._show_error("Root 密码至少需要 6 个字符")
            return False

        if rootpass != rootpass2:
            self._show_error("两次输入的 Root 密码不一致")
            return False

        if not hostname:
            self._show_error("请输入计算机名")
            return False

        return True

    def _show_error(self, msg):
        dialog = Gtk.MessageDialog(
            transient_for=self.wizard,
            modal=True,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.OK,
            text="输入错误"
        )
        dialog.format_secondary_text(msg)
        dialog.run()
        dialog.destroy()



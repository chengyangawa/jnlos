#!/usr/bin/env bash
# ============================================================================
# Java Net Lava OS 安装程序 - Worker 后台脚本
# ============================================================================
# 由 jnl-gui-installer 通过 pkexec 调用
# 用法：jnl-installer-worker <config_file>
# 输出格式：STEP|<index>|<status>  ← 供 Python 主程序解析更新进度
# 退出码：0 = 成功，非 0 = 失败（绝不允许失败时伪装成功）
# ============================================================================

set -o pipefail

# ===== 常量 =====
WORKER_LOG="/tmp/jnl-installer-worker.log"
COMPLETE_FLAG="/tmp/jnl-install-complete"
ERROR_FLAG="/tmp/jnl-installer-error"
CONFIG_FILE="${1:-/tmp/jnl-installer-config.json}"

# 步骤索引（必须与主程序 STEPS 列表保持一致）
STEP_PREPARE=0
STEP_TOOLS=1
STEP_PARTITION=2
STEP_FORMAT=3
STEP_MOUNT=4
STEP_COPY=5
STEP_FSTAB=6
STEP_CHROOT=7
STEP_GRUB=8
STEP_VERIFY=9
STEP_CLEANUP=10
STEP_DONE=11

# ===== 初始化日志（必须在任何输出之前）=====
> "$WORKER_LOG"
exec >> "$WORKER_LOG" 2>&1

# ===== 强制 root =====
if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: 需要 root 权限运行此脚本"
    exit 99
fi

echo "================================================================"
echo "  JNL OS Installer Worker"
echo "  启动时间: $(date '+%Y-%m-%d %H:%M:%S')"
echo "  PID: $$"
echo "  Config: $CONFIG_FILE"
echo "================================================================"

# ===== 工具函数 =====
step() {
    # step <index> <status>  → 输出 STEP|index|status 行供 Python 解析
    local idx="$1"
    local status="$2"
    echo "STEP|${idx}|${status}"
}

die() {
    # 致命错误：记录、标记失败、退出
    local msg="$1"
    echo ""
    echo "✗ [FATAL] $msg"
    echo "ERROR: $msg" > "$ERROR_FLAG"
    echo "ERROR_TIME=$(date '+%Y-%m-%d %H:%M:%S')" >> "$ERROR_FLAG"
    step -1 "安装失败：$msg"
    exit 1
}

cleanup_mounts() {
    # 卸载所有挂载点（容错）
    for mp in /mnt/home /mnt/boot/efi /mnt/boot /mnt; do
        mountpoint -q "$mp" 2>/dev/null && umount -R "$mp" 2>/dev/null
    done
    # 强制交换 off
    swapoff -a 2>/dev/null || true
    # 关闭已打开的 luks（如果有）
    for d in /dev/mapper/arch_*; do
        [ -e "$d" ] && cryptsetup close "$d" 2>/dev/null || true
    done
}

trap 'cleanup_mounts' EXIT
trap 'die "脚本被中断"' INT TERM

# ===== 读取配置 =====
if [ ! -f "$CONFIG_FILE" ]; then
    die "配置文件不存在: $CONFIG_FILE"
fi

# 用 python 解析 JSON（因为 bash 不能直接处理 JSON）
read_config() {
    python3 -c "
import json, sys
with open('$CONFIG_FILE', 'r', encoding='utf-8') as f:
    c = json.load(f)
for k, v in c.items():
    v = '' if v is None else str(v)
    # 转义单引号
    v = v.replace(\"'\", \"'\\\\''\")
    print(f\"{k}='{v}'\")
"
}

if ! eval "$(read_config)"; then
    die "解析配置文件失败"
fi

# 设置默认值
: "${install_mode:=auto}"
: "${target_disk:=}"
: "${esp_part:=}"
: "${root_part:=}"
: "${home_part:=}"
: "${username:=jnluser}"
: "${user_password:=jnlos}"
: "${root_password:=$user_password}"
: "${hostname:=JNL-OS}"
: "${timezone:=Asia/Shanghai}"
: "${language:=zh_CN.UTF-8}"
: "${keyboard:=us}"

echo ""
echo "[配置]"
echo "  install_mode  = $install_mode"
echo "  target_disk   = $target_disk"
echo "  esp_part      = $esp_part"
echo "  root_part     = $root_part"
echo "  home_part     = $home_part"
echo "  username      = $username"
echo "  hostname      = $hostname"
echo "  timezone      = $timezone"
echo "  language      = $language"
echo ""

# ===== Live 环境检查 =====
if [ ! -d /run/archiso ]; then
    die "此脚本只能在 Live 环境中运行"
fi

# ============================================================================
# 步骤 0: 准备环境
# ============================================================================
step $STEP_PREPARE "正在准备安装环境..."

# 清理可能残留的挂载
cleanup_mounts

# 确保有 bash 4+（关联数组需要）
if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
    die "Bash 版本过低：${BASH_VERSION}"
fi

# 同步时钟（避免 pacman keyring 出错）
timedatectl set-ntp true 2>/dev/null || true
hwclock --systohc 2>/dev/null || true

# 启动 dbus（arch-chroot 需要）
if ! pgrep -x dbus-daemon >/dev/null 2>&1; then
    mkdir -p /run/dbus
    dbus-daemon --system --fork 2>/dev/null || true
fi

step $STEP_PREPARE "准备完成"
echo "✓ 步骤 0 (准备) 完成"

# ============================================================================
# 步骤 1: 安装必要工具
# ============================================================================
step $STEP_TOOLS "正在安装必要工具..."

# 先尝试用已有的工具，缺失再装
NEEDED_TOOLS=("parted" "mkfs.fat" "mkfs.ext4" "grub-install" "rsync" "arch-chroot" "mkinitcpio" "blkid" "fsck.fat")
MISSING=()
for t in "${NEEDED_TOOLS[@]}"; do
    command -v "$t" >/dev/null 2>&1 || MISSING+=("$t")
done

if [ ${#MISSING[@]} -gt 0 ]; then
    echo "  缺失工具: ${MISSING[*]}"
    echo "  正在安装..."
    if ! pacman -Sy --noconfirm --needed \
        parted e2fsprogs dosfstools grub efibootmgr os-prober mtools rsync \
        arch-install-scripts mkinitcpio 2>&1 | tail -20; then
        die "工具安装失败"
    fi
else
    echo "  所有工具已存在"
fi

# 再次确认
for t in "${NEEDED_TOOLS[@]}"; do
    if ! command -v "$t" >/dev/null 2>&1; then
        die "工具仍不可用: $t"
    fi
done

step $STEP_TOOLS "工具安装完成"
echo "✓ 步骤 1 (工具) 完成"

# ============================================================================
# 步骤 2: 磁盘分区
# ============================================================================
step $STEP_PARTITION "正在创建磁盘分区..."

# 检测启动模式
if [ -d /sys/firmware/efi ]; then
    BOOT_MODE="efi"
else
    BOOT_MODE="bios"
fi
echo "  启动模式: $BOOT_MODE"

if [ "$install_mode" = "auto" ]; then
    # ---- 自动模式：整盘自动分区 ----
    DISK="$target_disk"
    if [ -z "$DISK" ] || [ ! -b "$DISK" ]; then
        die "目标磁盘无效: '$DISK'"
    fi

    DISK_SIZE=$(blockdev --getsize64 "$DISK" 2>/dev/null || echo 0)
    if [ "$DISK_SIZE" -le 0 ] 2>/dev/null; then
        die "无法读取磁盘大小: $DISK"
    fi
    DISK_SIZE_GB=$((DISK_SIZE / 1024 / 1024 / 1024))
    if [ "$DISK_SIZE_GB" -lt 10 ]; then
        die "磁盘大小不足 10GB（${DISK_SIZE_GB}GB）"
    fi

    echo "  目标磁盘: $DISK (${DISK_SIZE_GB}GB)"

    # 卸载可能已挂载的分区
    for part in $(lsblk -nrpo NAME "$DISK" 2>/dev/null | grep -v "^$DISK$"); do
        mountpoint -q "$part" 2>/dev/null && umount "$part" 2>/dev/null
        # 关闭 swap
        if grep -q "^$part " /proc/swaps 2>/dev/null; then
            swapoff "$part" 2>/dev/null || true
        fi
    done

    # 清除磁盘开头 1MB 和签名
    dd if=/dev/zero of="$DISK" bs=1M count=1 status=none 2>/dev/null || true
    wipefs -a -f "$DISK" 2>/dev/null || true
    sleep 1

    # 创建 GPT 分区表
    echo "  创建 GPT 分区表..."
    if ! parted -s "$DISK" mklabel gpt; then
        die "创建 GPT 分区表失败"
    fi
    sleep 1
    partprobe "$DISK" 2>/dev/null || true
    sleep 1

    # 根据启动模式创建分区
    if [ "$BOOT_MODE" = "bios" ]; then
        # BIOS 模式：需要 BIOS Boot 分区（ef02）用于 GRUB 嵌入
        echo "  创建 BIOS Boot 分区 (1MB)..."
        if ! parted -s "$DISK" mkpart biosboot 1MiB 2MiB; then
            die "创建 BIOS Boot 分区失败"
        fi
        if ! parted -s "$DISK" set 1 bios_grub on; then
            die "设置 BIOS Boot 标志失败"
        fi

        # 创建根分区 (2MiB -> 100%)
        echo "  创建根分区 (剩余空间)..."
        if ! parted -s "$DISK" mkpart primary ext4 2MiB 100%; then
            die "创建根分区失败"
        fi
    else
        # EFI 模式：创建 ESP 分区
        echo "  创建 ESP 分区 (512MB)..."
        if ! parted -s "$DISK" mkpart ESP fat32 1MiB 513MiB; then
            die "创建 ESP 分区失败"
        fi
        if ! parted -s "$DISK" set 1 esp on; then
            die "设置 ESP 标志失败"
        fi

        # 创建根分区 (513MiB -> 100%)
        echo "  创建根分区 (剩余空间)..."
        if ! parted -s "$DISK" mkpart primary ext4 513MiB 100%; then
            die "创建根分区失败"
        fi
    fi

    sleep 1
    partprobe "$DISK" 2>/dev/null || true
    sleep 2

    # 推断分区设备名
    if [[ "$DISK" == /dev/nvme* ]] || [[ "$DISK" == /dev/mmcblk* ]]; then
        if [ "$BOOT_MODE" = "bios" ]; then
            BIOS_BOOT="${DISK}p1"
            ROOT="${DISK}p2"
            ESP=""
        else
            ESP="${DISK}p1"
            ROOT="${DISK}p2"
        fi
    else
        if [ "$BOOT_MODE" = "bios" ]; then
            BIOS_BOOT="${DISK}1"
            ROOT="${DISK}2"
            ESP=""
        else
            ESP="${DISK}1"
            ROOT="${DISK}2"
        fi
    fi

    # 等待设备就绪
    echo "  等待分区设备就绪..."
    READY=false
    for i in $(seq 1 15); do
        if [ "$BOOT_MODE" = "bios" ]; then
            if [ -b "$BIOS_BOOT" ] && [ -b "$ROOT" ]; then
                READY=true
                break
            fi
        else
            if [ -b "$ESP" ] && [ -b "$ROOT" ]; then
                READY=true
                break
            fi
        fi
        sleep 1
    done
    if [ "$READY" != "true" ]; then
        die "分区设备未就绪"
    fi

    if [ "$BOOT_MODE" = "bios" ]; then
        echo "  BIOS_BOOT: $BIOS_BOOT"
    else
        echo "  ESP: $ESP"
    fi
    echo "  ROOT: $ROOT"

else
    # ---- 手动模式：使用已有分区 ----
    ESP="$esp_part"
    ROOT="$root_part"
    HOME="$home_part"
    if [ -z "$ESP" ] || [ ! -b "$ESP" ]; then
        die "ESP 分区无效: '$ESP'"
    fi
    if [ -z "$ROOT" ] || [ ! -b "$ROOT" ]; then
        die "根分区无效: '$ROOT'"
    fi
    if [ -n "$HOME" ] && [ ! -b "$HOME" ]; then
        echo "  警告: home 分区 '$HOME' 不存在，将忽略"
        HOME=""
    fi
    echo "  ESP: $ESP"
    echo "  ROOT: $ROOT"
    echo "  HOME: ${HOME:-<无>}"
fi

step $STEP_PARTITION "分区完成"
echo "✓ 步骤 2 (分区) 完成"

# ============================================================================
# 步骤 3: 格式化文件系统
# ============================================================================
step $STEP_FORMAT "正在格式化文件系统..."

# 卸载（如果之前有挂载）
umount "$ESP" 2>/dev/null || true
umount "$ROOT" 2>/dev/null || true
[ -n "$home_part" ] && umount "$home_part" 2>/dev/null || true
sleep 1

# 格式化 ESP（仅 EFI 模式）
if [ "$BOOT_MODE" = "efi" ] && [ -n "$ESP" ]; then
    echo "  格式化 ESP ($ESP) 为 FAT32..."
    if ! mkfs.fat -F 32 -n "JNL-ESP" "$ESP"; then
        die "FAT32 格式化失败: $ESP"
    fi

    # 校验 FAT32
    echo "  校验 ESP..."
    if ! fsck.fat -n "$ESP" 2>/dev/null; then
        echo "  fsck -n 检测到错误，尝试自动修复..."
        if ! fsck.fat -a "$ESP" 2>/dev/null; then
            die "FAT32 校验失败: $ESP"
        fi
    fi
else
    echo "  BIOS 模式：跳过 ESP 格式化"
fi

# 格式化 ROOT
echo "  格式化 ROOT ($ROOT) 为 ext4..."
if ! mkfs.ext4 -F -L "JNL-OS" "$ROOT"; then
    die "ext4 格式化失败: $ROOT"
fi

# 格式化 home（如果提供且是手动模式）
if [ "$install_mode" = "manual" ] && [ -n "$home_part" ] && [ -b "$home_part" ]; then
    HOME_FSTYPE=$(lsblk -no FSTYPE "$home_part" 2>/dev/null | head -1)
    if [ "$HOME_FSTYPE" != "ext4" ]; then
        echo "  格式化 HOME ($home_part) 为 ext4..."
        if ! mkfs.ext4 -F -L "JNL-HOME" "$home_part"; then
            die "ext4 格式化失败: $home_part"
        fi
    else
        echo "  HOME ($home_part) 已是 ext4，跳过格式化"
    fi
fi

# 同步
sync
sleep 1

step $STEP_FORMAT "格式化完成"
echo "✓ 步骤 3 (格式化) 完成"

# ============================================================================
# 步骤 4: 挂载磁盘
# ============================================================================
step $STEP_MOUNT "正在挂载磁盘..."

# 清理
cleanup_mounts

# 挂载根
mkdir -p /mnt
if ! mount "$ROOT" /mnt; then
    die "挂载根分区失败: $ROOT"
fi
echo "  已挂载 $ROOT -> /mnt"

# 挂载 boot（ESP 直接挂到 /mnt/boot，仅 EFI 模式）
if [ "$BOOT_MODE" = "efi" ] && [ -n "$ESP" ]; then
    mkdir -p /mnt/boot
    if ! mount "$ESP" /mnt/boot; then
        die "挂载 ESP 失败: $ESP"
    fi
    echo "  已挂载 $ESP -> /mnt/boot"
else
    echo "  BIOS 模式：跳过 ESP 挂载"
    mkdir -p /mnt/boot
fi

# 挂载 home（如果有）
if [ "$install_mode" = "manual" ] && [ -n "$home_part" ] && [ -b "$home_part" ]; then
    mkdir -p /mnt/home
    if ! mount "$home_part" /mnt/home; then
        die "挂载 home 分区失败: $home_part"
    fi
    echo "  已挂载 $home_part -> /mnt/home"
fi

# 创建基础目录
mkdir -p /mnt/{dev,proc,sys,run,tmp,boot/efi}
chmod 1777 /mnt/tmp

step $STEP_MOUNT "挂载完成"
echo "✓ 步骤 4 (挂载) 完成"

# ============================================================================
# 步骤 5: 复制系统文件
# ============================================================================
step $STEP_COPY "正在复制系统文件（0%）..."

echo "  复制 Live 系统到目标盘..."
rsync -aAX --info=progress2 \
    --exclude='/proc/*' \
    --exclude='/sys/*' \
    --exclude='/dev/*' \
    --exclude='/run/*' \
    --exclude='/tmp/*' \
    --exclude='/mnt/*' \
    --exclude='/boot/*' \
    --exclude='/etc/mkinitcpio.conf.d/archiso.conf' \
    --exclude='/etc/machine-id' \
    --exclude='/etc/fstab' \
    --exclude='/home/*' \
    / /mnt/ 2>&1 | while read -r line; do
    echo "$line"
    percent=$(echo "$line" | grep -o '[0-9]*%' | sed 's/%//')
    if [ -n "$percent" ] && [ "$percent" -ge 0 ] 2>/dev/null; then
        step $STEP_COPY "正在复制系统文件（${percent}%）..."
    fi
done || die "rsync 复制失败"

# 复制内核到 /mnt/boot
echo "  复制内核文件..."
KERNEL_SRC=""
for src in \
    /run/archiso/bootmnt/arch/boot/x86_64/vmlinuz-linux-lts \
    /boot/vmlinuz-linux-lts \
    /run/archiso/bootmnt/arch/boot/x86_64/vmlinuz-linux \
    /boot/vmlinuz-linux; do
    if [ -f "$src" ]; then
        KERNEL_SRC="$src"
        break
    fi
done

if [ -z "$KERNEL_SRC" ]; then
    die "找不到内核文件"
fi

if ! cp -v "$KERNEL_SRC" /mnt/boot/vmlinuz-linux-lts; then
    die "复制内核失败"
fi

# 复制微码
for ucode in /run/archiso/bootmnt/arch/boot/x86_64/*-ucode.img /boot/*-ucode.img; do
    [ -f "$ucode" ] && cp -v "$ucode" /mnt/boot/ 2>/dev/null || true
done

# 验证关键文件
if [ ! -f /mnt/usr/bin/bash ]; then
    die "系统复制不完整：/mnt/usr/bin/bash 缺失"
fi
if [ ! -d /mnt/usr/lib/modules ]; then
    die "系统复制不完整：/mnt/usr/lib/modules 缺失"
fi

step $STEP_COPY "系统文件复制完成"
echo "✓ 步骤 5 (复制) 完成"

# ============================================================================
# 步骤 6: 生成 fstab
# ============================================================================
step $STEP_FSTAB "正在配置 fstab..."

ROOT_UUID=$(blkid -s UUID -o value "$ROOT" 2>/dev/null || true)
ESP_UUID=""
if [ "$BOOT_MODE" = "efi" ] && [ -n "$ESP" ]; then
    ESP_UUID=$(blkid -s UUID -o value "$ESP" 2>/dev/null || true)
fi
HOME_UUID=""
if [ -n "$home_part" ] && [ -b "$home_part" ]; then
    HOME_UUID=$(blkid -s UUID -o value "$home_part" 2>/dev/null || true)
fi

if [ -z "$ROOT_UUID" ]; then
    die "无法读取分区 UUID"
fi

echo "  ROOT_UUID=$ROOT_UUID"
[ -n "$ESP_UUID" ] && echo "  ESP_UUID=$ESP_UUID"
[ -n "$HOME_UUID" ] && echo "  HOME_UUID=$HOME_UUID"

cat > /mnt/etc/fstab <<EOF_FSTAB
# /etc/fstab - JNL OS 1.0.30
# <device>                                <mount>  <fs>    <options>                                 <dump> <pass>
UUID=$ROOT_UUID   /        ext4   rw,noatime,errors=remount-ro                        0  1
EOF_FSTAB

# EFI 模式添加 ESP 条目
if [ "$BOOT_MODE" = "efi" ] && [ -n "$ESP_UUID" ]; then
    echo "UUID=$ESP_UUID    /boot    vfat   rw,noatime,fmask=0022,dmask=0022,codepage=437,iocharset=iso8859-1,shortname=mixed,utf8  0  2" >> /mnt/etc/fstab
fi

if [ -n "$HOME_UUID" ]; then
    echo "UUID=$HOME_UUID  /home   ext4   rw,noatime,errors=remount-ro                        0  2" >> /mnt/etc/fstab
fi

# 验证
if ! grep -q "$ROOT_UUID" /mnt/etc/fstab; then
    die "fstab 写入失败"
fi

step $STEP_FSTAB "fstab 配置完成"
echo "✓ 步骤 6 (fstab) 完成"

# ============================================================================
# 步骤 7: chroot 配置
# ============================================================================
step $STEP_CHROOT "正在配置系统（chroot）..."

# DNS
rm -f /mnt/etc/resolv.conf
cp -L /etc/resolv.conf /mnt/etc/resolv.conf 2>/dev/null || echo "nameserver 8.8.8.8" > /mnt/etc/resolv.conf

# 写入 chroot 配置脚本
mkdir -p /mnt/usr/local/bin
cat > /mnt/usr/local/bin/jnl-chroot-config.sh <<CHROOT_SCRIPT
#!/bin/bash
set -e

# 时区
echo "  设置时区: $timezone"
ln -sf "/usr/share/zoneinfo/$timezone" /etc/localtime
hwclock --systohc 2>/dev/null || true

# locale
echo "  配置 locale..."
sed -i 's/^#\?zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/' /etc/locale.gen
sed -i 's/^#\?en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
locale-gen 2>/dev/null || true
echo "LANG=$language" > /etc/locale.conf
echo "LC_ALL=$language" >> /etc/locale.conf

# 主机名
echo "  设置主机名: $hostname"
echo "$hostname" > /etc/hostname
cat > /etc/hosts <<EOF_HOSTS
127.0.0.1   localhost
::1         localhost
127.0.1.1   $hostname.localdomain $hostname
EOF_HOSTS

# 版本标记
echo "1.0.30" > /etc/jnl-os-version

# 激活信息
mkdir -p /etc/jnl-os
cat > /etc/jnl-os/activation.key <<ACTEOF
ACTIVATION_KEY=TRIAL
ACTIVATION_STATUS=试用模式
ACTIVATION_DATE=\$(date '+%Y-%m-%d %H:%M:%S')
ACTEOF
chmod 600 /etc/jnl-os/activation.key

# os-release
cat > /etc/os-release <<EOF_OS_RELEASE
NAME="Java Net Lava OS"
PRETTY_NAME="Java Net Lava OS 1.0.30"
ID=jnl-os
ID_LIKE=arch
VERSION="1.0.30"
VERSION_ID="1.0.30"
ANSI_COLOR="0;32"
HOME_URL="https://github.com/jnl-os"
SUPPORT_URL="https://github.com/jnl-os/issues"
BUG_REPORT_URL="https://github.com/jnl-os/issues"
EOF_OS_RELEASE

# sudoers
if ! grep -qE "^%wheel.*NOPASSWD" /etc/sudoers 2>/dev/null; then
    echo "%wheel ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers
fi

# 用户
if ! id -u "$username" &>/dev/null; then
    useradd -m -G wheel,audio,video,storage,optical,network,power,bluetooth -s /bin/bash "$username"
fi
echo "$username:$user_password" | chpasswd
echo "root:$root_password" | chpasswd

# 删除 archiso 的 live 用户
if [ "$username" != "archiso" ] && id -u "archiso" &>/dev/null; then
    userdel -r archiso 2>/dev/null || true
fi

# 修复 SDDM 自动登录配置
if [ -f /etc/sddm.conf ]; then
    sed -i "s/^User=.*/User=$username/" /etc/sddm.conf
    sed -i "s/^Session=.*/Session=plasma.desktop/" /etc/sddm.conf
    if ! grep -q "^Session=" /etc/sddm.conf; then
        sed -i '/^\[Autologin\]/a Session=plasma.desktop' /etc/sddm.conf
    fi
fi

# 移除 Live 环境痕迹
rm -f /etc/mkinitcpio.conf.d/archiso.conf
rm -f /usr/share/xsessions/jnl-installer.desktop
rm -f /usr/local/bin/jnl-installer-session
rm -f /home/jnluser/.config/autostart/jnl-live-installer.desktop 2>/dev/null || true
rm -f /etc/xdg/autostart/jnl-live-installer.desktop 2>/dev/null || true
rm -f /usr/bin/jnl-live-autostart 2>/dev/null || true

# mkinitcpio 配置
cat > /etc/mkinitcpio.conf <<'EOF_MKINITCPIO'
MODULES=()
BINARIES=()
FILES=()
HOOKS=(base udev autodetect microcode modconf kms keyboard keymap consolefont block filesystems fsck)
COMPRESSION="zstd"
COMPRESSION_OPTIONS=()
EOF_MKINITCPIO

cat > /etc/mkinitcpio.d/linux-lts.preset <<'EOF_PRESET'
PRESETS=('default' 'fallback')
ALL_kver='/boot/vmlinuz-linux-lts'
default_image="/boot/initramfs-linux-lts.img"
default_options=""
fallback_image="/boot/initramfs-linux-lts-fallback.img"
fallback_options="-S autodetect"
EOF_PRESET

# GRUB 默认配置
cat > /etc/default/grub <<'EOF_GRUB_DEFAULT'
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="Java Net Lava OS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""
GRUB_PRELOAD_MODULES="part_gpt part_msdos"
GRUB_ENABLE_CRYPTODISK=n
GRUB_GFXMODE=auto
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_DISABLE_OS_PROBER=false
GRUB_SAVEDEFAULT=false
GRUB_THEME="/usr/share/grub/themes/jnl-os/theme.txt"
EOF_GRUB_DEFAULT

# 验证内核
if [ ! -f /boot/vmlinuz-linux-lts ]; then
    echo "  错误：/boot/vmlinuz-linux-lts 缺失"
    exit 1
fi

# 生成 initramfs
echo "  生成 initramfs..."
if ! mkinitcpio -p linux-lts 2>&1 | tail -10; then
    echo "  mkinitcpio -p 失败，尝试手动..."
    if ! mkinitcpio -k /boot/vmlinuz-linux-lts -g /boot/initramfs-linux-lts.img 2>&1 | tail -10; then
        echo "  initramfs 生成失败"
        exit 1
    fi
fi

# 验证 initramfs
if [ ! -f /boot/initramfs-linux-lts.img ]; then
    echo "  initramfs 验证失败"
    exit 1
fi
echo "  ✓ initramfs 已生成"

# machine-id
systemd-machine-id-setup 2>/dev/null || true

# 启用服务
echo "  启用系统服务..."
mkdir -p /etc/systemd/system/multi-user.target.wants
mkdir -p /etc/systemd/system/graphical.target.wants

enable_svc() {
    local svc="\$1"
    local unit=""
    for d in /usr/lib/systemd/system /etc/systemd/system; do
        if [ -f "\$d/\$svc" ]; then
            unit="\$d/\$svc"
            break
        fi
    done
    if [ -n "\$unit" ]; then
        ln -sf "\$unit" "/etc/systemd/system/multi-user.target.wants/\$svc"
        echo "  ✓ 启用 \$svc"
    else
        echo "  ! \$svc 单元文件未找到"
    fi
}

disable_svc() {
    rm -f "/etc/systemd/system/multi-user.target.wants/\$1" 2>/dev/null
    echo "  ✓ 禁用 \$1"
}

enable_svc NetworkManager.service
enable_svc wpa_supplicant.service
enable_svc bluetooth.service
enable_svc sddm.service
enable_svc jnl-wifi-daemon.service 2>/dev/null || true

# 确保 graphical.target 为默认
ln -sf /usr/lib/systemd/system/graphical.target /etc/systemd/system/default.target

disable_svc ldconfig.service
disable_svc man-db.service
disable_svc updatedb.service
disable_svc NetworkManager-wait-online.service
disable_svc jnl-wifi-autoscan.service 2>/dev/null || true

echo "  ✓ chroot 配置完成"
CHROOT_SCRIPT

chmod +x /mnt/usr/local/bin/jnl-chroot-config.sh

# 执行 chroot
echo "  执行 chroot 配置（最长 10 分钟）..."
if ! timeout 600 arch-chroot /mnt /bin/bash /usr/local/bin/jnl-chroot-config.sh; then
    die "chroot 配置失败（退出码 $?）"
fi

step $STEP_CHROOT "chroot 配置完成"
echo "✓ 步骤 7 (chroot) 完成"

# ============================================================================
# 步骤 8: 安装 GRUB
# ============================================================================
step $STEP_GRUB "正在安装 GRUB 引导..."

echo "  启动模式: $BOOT_MODE"

# 在 chroot 中安装 GRUB
cat > /mnt/usr/local/bin/jnl-grub-install.sh <<GRUB_EOF
#!/bin/bash
set -e

if [ "$BOOT_MODE" = "efi" ]; then
    echo "  grub-install (EFI)..."
    if ! grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=JNL-OS --recheck 2>&1; then
        echo "  重试 grub-install..."
        if ! grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=JNL-OS 2>&1; then
            echo "  ✗ grub-install EFI 失败"
            exit 1
        fi
    fi

    mkdir -p /boot/EFI/BOOT
    if [ -f /boot/EFI/JNL-OS/grubx64.efi ]; then
        cp -v /boot/EFI/JNL-OS/grubx64.efi /boot/EFI/BOOT/BOOTX64.EFI
        echo "  ✓ BOOTX64.EFI 已创建"
    else
        echo "  ! grubx64.efi 不存在"
        exit 1
    fi
else
    echo "  grub-install (BIOS)..."
    if ! grub-install --target=i386-pc --recheck "$DISK" 2>&1; then
        echo "  ✗ grub-install BIOS 失败"
        exit 1
    fi
    echo "  ✓ GRUB BIOS 安装完成"
fi

mkdir -p /boot/grub
ROOT_UUID_GRUB=\$(grep -m1 'UUID=' /etc/fstab | grep -o 'UUID=[a-f0-9-]*' | cut -d= -f2)
cat > /boot/grub/grub.cfg <<EOF_GRUB
set timeout=5
set default=0
menuentry "Java Net Lava OS" {
    linux /vmlinuz-linux-lts root=UUID=\$ROOT_UUID_GRUB rw quiet
    initrd /initramfs-linux-lts.img
}
menuentry "Java Net Lava OS (fallback)" {
    linux /vmlinuz-linux-lts root=UUID=\$ROOT_UUID_GRUB rw
    initrd /initramfs-linux-lts-fallback.img
}
EOF_GRUB

if [ -f /usr/bin/grub-mkconfig ]; then
    grub-mkconfig -o /boot/grub/grub.cfg 2>&1 | tail -5 || true
fi

echo "  ✓ GRUB 配置完成"
GRUB_EOF
chmod +x /mnt/usr/local/bin/jnl-grub-install.sh

if ! timeout 300 arch-chroot /mnt /bin/bash -c "BOOT_MODE=$BOOT_MODE DISK=$DISK /usr/local/bin/jnl-grub-install.sh"; then
    die "GRUB 安装失败"
fi

step $STEP_GRUB "GRUB 安装完成"
echo "✓ 步骤 8 (GRUB) 完成"

# ============================================================================
# 步骤 9: 验证安装
# ============================================================================
step $STEP_VERIFY "正在验证安装..."

VERIFY_FAILED=0

check() {
    local desc="$1"
    local path="$2"
    if [ -e "$path" ]; then
        echo "  ✓ $desc ($path)"
    else
        echo "  ✗ $desc 缺失 ($path)"
        VERIFY_FAILED=1
    fi
}

check "vmlinuz"           /mnt/boot/vmlinuz-linux-lts
check "initramfs"         /mnt/boot/initramfs-linux-lts.img
if [ "$BOOT_MODE" = "efi" ]; then
    check "grubx64.efi"   /mnt/boot/EFI/JNL-OS/grubx64.efi
    check "BOOTX64.EFI"   /mnt/boot/EFI/BOOT/BOOTX64.EFI
fi
check "grub.cfg"          /mnt/boot/grub/grub.cfg
check "fstab"             /mnt/etc/fstab
check "os-release"        /mnt/etc/os-release
check "version file"      /mnt/etc/jnl-os-version
check "bash"              /mnt/usr/bin/bash
check "systemd binary"    /mnt/usr/lib/systemd/systemd 2>/dev/null || check "systemd binary" /mnt/lib/systemd/systemd

# 验证 GRUB 配置包含 "Java Net Lava OS"
if [ -f /mnt/boot/grub/grub.cfg ] && ! grep -q "Java Net Lava" /mnt/boot/grub/grub.cfg; then
    echo "  ! grub.cfg 未包含 'Java Net Lava OS'"
    # 尝试在 chroot 中重新生成
fi

# 验证版本
INSTALLED_VER=$(cat /mnt/etc/jnl-os-version 2>/dev/null | tr -d ' \n')
if [ -z "$INSTALLED_VER" ]; then
    echo "  ✗ 版本文件为空"
    VERIFY_FAILED=1
else
    echo "  ✓ 系统版本: $INSTALLED_VER"
fi

# 验证 GRUB 引导 UUID
if [ -f /mnt/boot/grub/grub.cfg ]; then
    if grep -q "UUID=$ROOT_UUID" /mnt/boot/grub/grub.cfg; then
        echo "  ✓ GRUB UUID 正确"
    else
        echo "  ! GRUB UUID 可能不匹配（期望: $ROOT_UUID）"
    fi
fi

if [ $VERIFY_FAILED -ne 0 ]; then
    die "关键文件验证失败，请检查日志"
fi

step $STEP_VERIFY "验证通过"
echo "✓ 步骤 9 (验证) 完成"

# ============================================================================
# 步骤 10: 清理
# ============================================================================
step $STEP_CLEANUP "正在清理..."

# 同步
sync

# 卸载目标盘（按逆序）
echo "  卸载目标盘..."
umount /mnt/home 2>/dev/null || true
umount /mnt/boot 2>/dev/null || true
umount /mnt 2>/dev/null || true

# 最后确认
if mountpoint -q /mnt 2>/dev/null; then
    echo "  ! /mnt 仍处于挂载状态，强制卸载..."
    umount -R /mnt 2>/dev/null || true
fi

# 删除 chroot 临时脚本
rm -f /mnt/usr/local/bin/jnl-chroot-config.sh 2>/dev/null || true
rm -f /mnt/usr/local/bin/jnl-grub-install.sh 2>/dev/null || true

# 创建完成标记文件（在 Live 环境的 /tmp，重启后失效）
touch "$COMPLETE_FLAG"
rm -f "$ERROR_FLAG"

step $STEP_CLEANUP "清理完成"
echo "✓ 步骤 10 (清理) 完成"

# ============================================================================
# 步骤 11: 完成
# ============================================================================
step $STEP_DONE "安装成功！"
echo ""
echo "================================================================"
echo "  ✓ Java Net Lava OS 安装成功！"
echo "  版本: 1.0.30"
echo "  用户: $username"
echo "  主机: $hostname"
echo "  模式: $install_mode"
echo "================================================================"
echo ""
echo "  请重启计算机并从硬盘启动"

exit 0

#!/bin/bash
# JNL OS 系统更新工具
# 用途：从 ISO 更新已安装的 JNL OS 到最新版本
# 用法：sudo jnl-update [ISO文件路径]
#
# 注意：
#   - 升级会保留 /home 目录中的用户数据
#   - 升级前会自动备份 /home 到 /var/jnl-upgrade-backup-DATE
#   - 升级后需要重启系统

set -e

if [ "$EUID" -ne 0 ]; then
    echo "错误：请使用 root 权限运行（sudo jnl-update）"
    exit 1
fi

ISO_FILE="${1:-}"
CURRENT_VERSION=$(cat /etc/jnl-os-version 2>/dev/null || echo "未知")

echo "================================================"
echo "  JNL OS 系统更新工具"
echo "================================================"
echo ""
echo "  当前版本: $CURRENT_VERSION"
echo ""

if [ -z "$ISO_FILE" ]; then
    echo "用法："
    echo "  sudo jnl-update /path/to/jnl-os-x.x.x-x86_64.iso"
    echo ""
    echo "此命令会将已安装的 JNL OS 升级到指定 ISO 中的版本"
    echo "注意："
    echo "  - 升级会保留 /home 目录中的用户数据"
    echo "  - 升级前会自动备份 /home 到 /var/jnl-upgrade-backup-DATE"
    echo "  - 升级后需要重启系统"
    echo ""
    echo "例如："
    echo "  1. 下载新的 ISO 到 /home/jnluser/Downloads/"
    echo "  2. sudo jnl-update /home/jnluser/Downloads/jnl-os-1.0.12-x86_64.iso"
    echo "  3. 等待升级完成"
    echo "  4. sudo reboot"
    exit 0
fi

if [ ! -f "$ISO_FILE" ]; then
    echo "错误：ISO 文件不存在: $ISO_FILE"
    exit 1
fi

# 检查 ISO 文件大小（至少 1GB）
ISO_SIZE=$(stat -c%s "$ISO_FILE" 2>/dev/null || echo 0)
if [ "$ISO_SIZE" -lt 1000000000 ]; then
    echo "错误：ISO 文件大小异常（小于 1GB），可能不是有效的 JNL OS ISO"
    exit 1
fi

echo "检测到 ISO: $ISO_FILE"
ISO_SIZE_HUMAN=$(numfmt --to=iec --suffix=B "$ISO_SIZE" 2>/dev/null || echo "${ISO_SIZE}B")
echo "ISO 大小: $ISO_SIZE_HUMAN"
echo ""

# 检查可用磁盘空间（至少需要 10GB）
AVAIL_SPACE=$(df / | tail -1 | awk '{print $4}')
AVAIL_SPACE_GB=$((AVAIL_SPACE / 1024 / 1024))
if [ "$AVAIL_SPACE_GB" -lt 10 ]; then
    echo "错误：可用磁盘空间不足 10GB（当前 ${AVAIL_SPACE_GB}GB）"
    echo "升级需要至少 10GB 空闲空间"
    exit 1
fi

read -p "确认要升级 JNL OS 吗？升级过程将持续数分钟。(y/N): " confirm
if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
    echo "已取消"
    exit 0
fi

echo ""
echo "================================================"
echo "  开始升级"
echo "================================================"

# 1. 挂载 ISO
echo "[1/6] 挂载 ISO..."
MOUNT_DIR=$(mktemp -d)
mount -o loop,ro "$ISO_FILE" "$MOUNT_DIR" 2>/dev/null || {
    echo "错误：无法挂载 ISO"
    rmdir "$MOUNT_DIR" 2>/dev/null
    exit 1
}
echo "  ✓ ISO 已挂载到 $MOUNT_DIR"

# 查找 SquashFS 文件（不同 archiso 版本位置可能不同）
SQUASHFS_FILE=""
for path in \
    "$MOUNT_DIR/arch/x86_64/airootfs.sfs" \
    "$MOUNT_DIR/arch/x86_64/filesystem.sfs" \
    "$MOUNT_DIR/airootfs.sfs" \
    "$MOUNT_DIR/filesystem.sfs"; do
    if [ -f "$path" ]; then
        SQUASHFS_FILE="$path"
        break
    fi
done

if [ -z "$SQUASHFS_FILE" ]; then
    echo "错误：在 ISO 中找不到 airootfs.sfs 文件"
    echo "可能不是有效的 JNL OS ISO"
    umount "$MOUNT_DIR"
    rmdir "$MOUNT_DIR"
    exit 1
fi

echo "  ✓ 找到 SquashFS: $SQUASHFS_FILE"

# 2. 备份用户数据
echo "[2/6] 备份用户配置..."
BACKUP_DIR="/var/jnl-upgrade-backup-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BACKUP_DIR"
if [ -d /home ]; then
    cp -a /home "$BACKUP_DIR/" 2>/dev/null || true
fi
cp -a /etc/sddm.conf "$BACKUP_DIR/" 2>/dev/null || true
cp -a /etc/sddm.conf.d "$BACKUP_DIR/" 2>/dev/null || true
cp -a /etc/hostname "$BACKUP_DIR/" 2>/dev/null || true
cp -a /etc/hosts "$BACKUP_DIR/" 2>/dev/null || true
cp -a /etc/jnl-os-user "$BACKUP_DIR/" 2>/dev/null || true
cp -a /etc/jnl-os-version "$BACKUP_DIR/" 2>/dev/null || true
echo "  ✓ 备份到: $BACKUP_DIR"

# 3. 解压 SquashFS
echo "[3/6] 解压 SquashFS（这可能需要几分钟）..."
EXTRACT_DIR=$(mktemp -d)
unsquashfs -d "$EXTRACT_DIR/squashfs-root" "$SQUASHFS_FILE" >/dev/null 2>&1 || {
    echo "错误：解压 SquashFS 失败"
    umount "$MOUNT_DIR"
    rmdir "$MOUNT_DIR"
    rm -rf "$EXTRACT_DIR"
    exit 1
}
echo "  ✓ SquashFS 已解压"

# 4. 升级系统文件
echo "[4/6] 升级系统文件..."
rsync -aAX --info=progress2 \
    --exclude="/home" \
    --exclude="/var/log" \
    --exclude="/var/tmp" \
    --exclude="/tmp" \
    --exclude="/proc" \
    --exclude="/sys" \
    --exclude="/dev" \
    --exclude="/run" \
    --exclude="/boot" \
    --exclude="/etc/fstab" \
    --exclude="/etc/hostname" \
    --exclude="/etc/hosts" \
    --exclude="/etc/sddm.conf" \
    --exclude="/etc/sddm.conf.d" \
    --exclude="/etc/jnl-os-user" \
    --exclude="/var/jnl-upgrade-backup-*" \
    "$EXTRACT_DIR/squashfs-root/" / 2>&1 | tail -3
echo "  ✓ 系统文件升级完成"

# 5. 修复 initramfs 和重建缓存
echo "[5/6] 修复 initramfs 和重建系统缓存..."
# 移除 archiso hooks（防止 Live CD 模式干扰）
if [ -f /etc/mkinitcpio.conf.d/archiso.conf ]; then
    mv /etc/mkinitcpio.conf.d/archiso.conf /etc/mkinitcpio.conf.d/archiso.conf.backup
fi

# 重新生成 initramfs
if [ -f /etc/mkinitcpio.d/linux-lts.preset ]; then
    mkinitcpio -p linux-lts 2>&1 | tail -3
elif [ -f /etc/mkinitcpio.d/linux.preset ]; then
    mkinitcpio -p linux 2>&1 | tail -3
fi

# 重建 KDE 系统配置缓存
if command -v kbuildsycoca6 >/dev/null 2>&1; then
    rm -rf /var/tmp/kdecache-* 2>/dev/null || true
    kbuildsycoca6 --noincremental 2>/dev/null || true
    echo "  ✓ KDE 系统配置缓存已重建"
fi

# 更新应用数据库
update-desktop-database /usr/share/applications 2>/dev/null || true
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true

# 6. 清理
echo "[6/6] 清理..."
umount "$MOUNT_DIR" 2>/dev/null || true
rmdir "$MOUNT_DIR" 2>/dev/null || true
rm -rf "$EXTRACT_DIR"

echo ""
echo "================================================"
echo "  升级完成！"
echo "================================================"
echo ""
echo "  ✓ 用户数据已备份到: $BACKUP_DIR"
echo "  ✓ 系统已升级到最新版本"
echo ""
echo "  重要：建议重启系统以应用所有更改"
echo "    sudo reboot"
echo ""
echo "  如果遇到问题，可从备份恢复："
echo "    sudo cp -a $BACKUP_DIR/home/* /home/"
echo ""
